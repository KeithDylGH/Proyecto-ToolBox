<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Actualizar Contraseña</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <script defer src="/js/claveOlvidada.js"></script>
    <style>
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        .header img {
            max-width: 150px;
        }
        .form-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 80vh;
        }
    </style>
</head>
<body>
    <header class="header">
        <img src="/img/logo/Logo 180.png" alt="Logo"> <!-- Cambia el src al path de tu logo -->
    </header>
    <div class="container form-container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h2 class="text-center">Actualizar Contraseña</h2>
                <form id="changePasswordForm">
                    <!-- Token y correo ocultos -->
                    <input type="hidden" name="token" value="<%= token %>">
                    <input type="hidden" name="correo" value="<%= correo %>">
                    <div class="form-group">
                        <label for="correoUsuario">Correo Electrónico</label>
                        <input type="text" class="form-control" id="correoUsuario" value="<%= correo %>" readonly>
                    </div>
                    <div class="form-group">
                        <label for="nuevaPassword">Nueva Contraseña</label>
                        <input type="password" class="form-control" id="nuevaPassword" name="nuevaPassword" required>
                    </div>
                    <div class="form-group">
                        <label for="confirmarPassword">Confirmar Contraseña</label>
                        <input type="password" class="form-control" id="confirmarPassword" name="confirmarPassword" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Cambiar Contraseña</button>
                    <div class="notification mt-3"></div>
                </form>                
            </div>
        </div>
    </div>
</body>
</html>