<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Actualizar Contraseña</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <script defer src="/js/claveOlvidada.js"></script>
    <style>
        .header {
            background-color: #666F88; 
            padding: 10px 0;
        }
        .form-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 80vh;
        }
    </style>
</head>
<body>
    <header class="header">
        <nav class="navbar navbar-expand-lg" style="padding: 0 2.5rem; font-size: 1.1rem;">
            <div class="container-fluid d-flex">
                <a class="text-light navbar-brand" href="/" style="display: inline-block; margin-right: 25px;">
                    <img src="/img/logo/Logo trazo 180.png" alt="Logo" width="30" height="24" class="d-inline-block align-text-top">
                    ToolBox
                </a>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/">Inicio</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container form-container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h2 class="text-center">Actualizar Contraseña</h2>
                <form id="changePasswordForm">
                    <!-- Token y correo ocultos -->
                    <input type="hidden" name="token" value="<%= token %>">
                    <input type="hidden" name="correo" value="<%= correo %>">
                    <div class="form-group">
                        <label for="correoUsuario">Correo Electrónico</label>
                        <input type="text" class="form-control" id="correoUsuario" value="<%= correo %>" readonly>
                    </div>
                    <div class="form-group">
                        <label for="nuevaPassword">Nueva Contraseña</label>
                        <input type="password" class="form-control" id="nuevaPassword" name="nuevaPassword" required>
                    </div>
                    <div class="form-group">
                        <label for="confirmarPassword">Confirmar Contraseña</label>
                        <input type="password" class="form-control" id="confirmarPassword" name="confirmarPassword" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Cambiar Contraseña</button>
                    <div class="notification mt-3"></div>
                </form>                
            </div>
        </div>
    </div>
</body>
</html>