<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Actualizar Contraseña</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <script defer src="/js/claveOlvidada.js"></script>
</head>
<body>
    <div class="container mt-5">
        <h2 class="text-center">Actualizar Contraseña</h2>
        <div class="row justify-content-center">
            <div class="col-md-6">
                <form id="changePasswordForm">
                    <input type="hidden" name="token" value="<%= token %>">
                    <div class="form-group">
                        <label for="nuevaPassword">Nueva Contraseña</label>
                        <input type="password" class="form-control" id="nuevaPassword" required>
                    </div>
                    <div class="form-group">
                        <label for="confirmarPassword">Confirmar Contraseña</label>
                        <input type="password" class="form-control" id="confirmarPassword" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Cambiar Contraseña</button>
                    <div class="notification mt-3"></div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>