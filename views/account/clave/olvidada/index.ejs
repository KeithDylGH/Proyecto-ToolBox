<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Olvidé la Contraseña</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <script defer src="/js/claveOlvidada.js"></script>
    <style>
        /* Estilos adicionales si es necesario */
        .header {
            background-color: #666F88; 
            padding: 10px 0;
        }
    </style>
</head>
<body>
    <header class="header">
        <nav class="navbar navbar-expand-lg" style="padding: 0 2.5rem; font-size: 1.1rem;">
            <div class="container-fluid d-flex">
                <a class="text-light navbar-brand" href="/" style="display: inline-block; margin-right: 25px;">
                    <img src="/img/logo/Logo trazo 180.png" alt="Logo" width="30" height="24" class="d-inline-block align-text-top">
                    ToolBox
                </a>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/">Inicio</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-5">
        <h2 class="text-center">Recuperar Contraseña</h2>
        <div class="row justify-content-center">
            <div class="col-md-6">
                <form id="resetPasswordForm">
                    <div class="form-group">
                        <label for="email">Correo Electrónico</label>
                        <input type="email" class="form-control" id="email" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Enviar Enlace de Restablecimiento</button>
                    <div class="notification mt-3"></div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>