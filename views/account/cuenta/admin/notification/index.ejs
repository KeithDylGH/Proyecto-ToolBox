<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notificaciones de Pago</title>
  <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/cuenta.css">
  
  <!--BOOTSTRAP-->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
</head>
<body>

  <div>
    <section>
      <!--Sidebar-->
      <div class="sidebar">
        <a href="#" id="homeBtn"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>

        <a class="active sidebar_btn" href="/cuenta" id="client">Inicio</a>
        <a href="/" id="pagBtn">Ir a la Pág. Principal</a>
        <a href="/cuenta/carrito" id="carritoBtn">Carrito</a>
        <a href="/cuenta/atencion" id="contactoBtn">Servicio al Cliente</a>
        <a href="/cuenta/configuracion" id="configuracionBtn">Configuración</a>

        <% if (CUsuario && CUsuario.rol === 'boss') { %>
          <a href="/cuenta/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
          <a href="/jefe/permisos" id="permisosBtn">Permisos</a>
        <% } else if (CUsuario && CUsuario.rol === 'admin') { %>
          <a href="/admin/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
        <% } %>

        <button class="Log-Out" id="logout"><a href="#">Cerrar sesión</a></button>
      </div>
    </section>

    <!--Contenido-->
    <section class="interfaz">
      <div class="container">
        <h1 class="text-center mt-4">Notificaciones de Compras</h1>
        <div class="row mt-4">
          <% if (notificaciones.length > 0) { %>
            <% notificaciones.forEach(notificacion => { %>
              <div class="col-md-4 mb-4">
                <div class="card">
                  <div class="card-body">
                    <h5 class="card-title">Compra por: <%= notificacion.usuarioNombre %></h5>
                    <p class="card-text">Correo: <%= notificacion.usuarioCorreo %></p>
                    <p class="card-text"><strong>Método de Pago:</strong> <%= notificacion.metodoPago %></p>
                    <p class="card-text"><strong>Total:</strong> $<%= notificacion.total.toFixed(2) %></p>
                    <p class="card-text"><strong>Productos:</strong></p>
                    <ul>
                      <% notificacion.productos.forEach(producto => { %>
                        <% if (producto && typeof producto.price === 'number') { %>
                          <li>
                            <%= producto.name %> - $<%= producto.price.toFixed(2) %> x <%= producto.quantity %>
                            <img src="<%= producto.imagen ? producto.imagen.data : '/img/default-product.jpg' %>" alt="<%= producto.name %>" style="width: 50px; height: auto;">
                          </li>
                        <% } else { %>
                          <li>Producto no disponible</li>
                        <% } %>
                      <% }) %>
                    </ul>
                    <p class="card-text"><small class="text-muted">Fecha: <%= notificacion.fecha.toLocaleString() %></small></p>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="atendido-<%= notificacion._id %>" onchange="updateNotificacion('<%= notificacion._id %>')" <%= notificacion.atendido ? 'checked' : '' %> >
                      <label class="form-check-label" for="atendido-<%= notificacion._id %>">
                        Marcado como atendido
                      </label>
                    </div>
                    <button class="btn btn-danger mt-2" onclick="deleteNotificacion('<%= notificacion._id %>')">Eliminar Notificación</button>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <p>No hay notificaciones de compras.</p>
          <% } %>
        </div>
      </div>
    </section>
  </div>

  <script src="/js/cuenta.js"></script>
  <script src="/js/logout.js"></script>
  <script src="/js/notificacionAdmin.js"></script>
</body>
</html>