<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ToolBox - Inventario</title>

    <link rel="icon" type="image/x-icon" href="/img/logo/LogoPagina.png">
    <link rel="stylesheet" href="/css/menuCuenta.css">
    <link rel="stylesheet" href="/css/sidebar.css">

    <!--BOOTSTRAP-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap"
        rel="stylesheet">
</head>

<body>
    <div>
        <section>
            <!--Sidebar-->
            <div class="sidebar">
                <a href="/"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>

                <a href="/cuenta" id="client">Inicio</a>
                <a href="/" id="pagBtn">Ir a la Pág. Principal</a>
                <a href="/cuenta/carrito" id="carritoBtn">Carrito</a>
                <a href="/cuenta/atencion" id="contactoBtn">Servicio al Cliente</a>
                <a href="/cuenta/configuracion" id="configuracionBtn">Configuración</a>

                <% if (CUsuario && CUsuario.rol === 'boss') { %>
                    <a href="/admin/notificacion">Notificación</a>
                    <a class="active sidebar_btn" href="/admin/inventario" id="inventarioBtn">Inventario</a>
                    <a href="/jefe/permisos" id="permisosBtn">Permisos</a>
                <% } else if (CUsuario && CUsuario.rol === 'admin') { %>
                    <a href="/admin/notificacion">Notificación</a>
                    <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
                <% } %>

                <button class="Log-Out"><a href="/logout">Cerrar sesión</a></button>
            </div>
        </section>

        <section class="interfaz" style="margin-left: 50px;">
            <div class="container">
                <div class="content">
                    <!-- Inventario -->
                    <div class="inventario">
                        <div class="card bg-dark text-white" style="padding: 5rem;">
                            <div class="card-img-overlay"
                                style="background-color: #5e3b3b;
                                    background: rgb(94,59,59);
                                    background: linear-gradient(153deg, rgba(94,59,59,1) 25%, rgba(52,44,44,1) 100%);">
                                <h3 class="card-title text-light">Gestiona tu Inventario</h3>
                                <p class="card-text">Administra los productos de ToolBox. Puedes agregar, editar y eliminar productos del inventario.</p>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-center">
                            <!-- Ver Productos -->
                            <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                                <div class="card-body">
                                    <h5 class="card-subtitle mb-2 mt-2">
                                        <img src="/img/icono/descripcion-general.png" alt="ver productos" width="50px">
                                        Ver Productos
                                    </h5>
                                    <p class="card-text">Explora y administra los productos de tu inventario.</p>
                                    <a href="/inventario/verproducto" class="card-link btn btn-danger">Ver Productos</a>
                                </div>
                            </div>

                            <!-- Agregar Productos -->
                            <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                                <div class="card-body">
                                    <h5 class="card-subtitle mb-2 mt-2">
                                        <img src="/img/icono/capa-mas.png" alt="agregar productos" width="50px">
                                        Agregar Productos
                                    </h5>
                                    <p class="card-text">Añade nuevos productos al stock, con precios e imágenes.</p>
                                    <a href="/inventario/agregarproduto" class="card-link btn btn-danger">Agregar Productos</a>
                                </div>
                            </div>

                            <!-- Categorías -->
                            <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                                <div class="card-body">
                                    <h5 class="card-subtitle mb-2 mt-2">
                                        <img src="/img/icono/aplicaciones-anadir.png" alt="categorías" width="50px">
                                        Categorías
                                    </h5>
                                    <p class="card-text">Agrega, edita y organiza las categorías de tu inventario.</p>
                                    <a href="/inventario/categoria" class="card-link btn btn-danger">Gestionar Categorías</a>
                                </div>
                            </div>

                            <!-- Descargar Inventario -->
                            <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                                <div class="card-body">
                                    <h5 class="card-subtitle mb-2 mt-2">
                                        <img src="/img/icono/archivo-pdf.png" alt="descargar inventario" width="50px">
                                        Descargar Inventario
                                    </h5>
                                    <p class="card-text">Descarga el inventario en formato PDF o Excel.</p>
                                    <a href="/inventario/descargarInv" class="card-link btn btn-danger">Descargar Inventario</a>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <script src="/js/admin.js"></script>
</body>

</html>