<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ToolBox Admin - Descargar Inventario</title>

    <link rel="icon" type="image/x-icon" href="/img/logo/LogoPagina.png">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/cuenta.css">
    <link rel="stylesheet" href="/css/notificacion.css">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/loader.css"> <!-- Agregado para el loader -->

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700&display=swap" rel="stylesheet">
</head>
<body>
    <header style="background-color: #666F88; padding: 10px 0;">
        <nav class="navbar navbar-expand-lg" style="padding: 0 2.5rem; font-size: 1.1rem;">
            <div class="container-fluid d-flex">
                <a class="text-light navbar-brand" href="/admin/inventario" style="display: inline-block; margin-right: 25px;">
                    <img src="/img/logo/Logo trazo 180.png" alt="Logo" width="30" height="24" class="d-inline-block align-text-top">
                    ToolBox Admin
                </a>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white active" aria-current="page" href="/admin/inventario">Inventario</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white active" aria-current="page" href="/">Inicio</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Categoría
                            </a>
                            <ul class="dropdown-menu">
                                <% if (categorias && Array.isArray(categorias) && categorias.length > 0) { %>
                                    <% categorias.forEach(categoria => { %>
                                        <li><a class="dropdown-item" href="/tienda/<%= categoria._id %>"><%= categoria.nombre %></a></li>
                                    <% }); %>
                                <% } else { %>
                                    <li><a class="dropdown-item" href="#">No hay categorías disponibles</a></li>
                                <% } %>
                            </ul>                            
                        </li>

                        <% if (CUsuario) { %>
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/cuenta"><%= CUsuario.usuario %></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/logout">Cerrar sesión</a>
                            </li>
                        <% } else { %>
                            <li class="nav-item">
                                <a class="nav-link text-white" id="login" href="/login">Iniciar sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" id="register" href="/registrar">Registrarse</a>
                            </li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </nav>
    </header>    

    <section class="container mt-4">
        <div class="py-4">
            <h2 class="text-center">Descargar Inventario</h2>
            <div class="d-flex justify-content-center mt-4">
                <a href="/api/descargar-inventario?format=pdf" class="btn btn-primary mx-2">Descargar en PDF</a>
                <a href="/api/descargar-inventario?format=excel" class="btn btn-success mx-2">Descargar en Excel</a>
            </div>
            <div class="table-responsive mt-4">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th style="font-size: 1.2rem;">Nombre</th>
                            <th style="font-size: 1.2rem;">Precio</th>
                            <th style="font-size: 1.2rem;">Categoría</th>
                            <th style="font-size: 1.2rem;">Descripción</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (productos && productos.length > 0) { %>
                            <% productos.forEach(producto => { %>
                                <tr>
                                    <td style="font-size: 1.1rem;"><%= producto.nombre %></td>
                                    <td style="font-size: 1.1rem;"><%= producto.precio %><strong> $</strong></td>
                                    <td style="font-size: 1.1rem;"><%= producto.categoria %></td>
                                    <td style="font-size: 1.1rem;"><%= producto.descripcion %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="4">No hay productos disponibles</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <footer class="mt-auto py-3 bg-dark text-light">
        <div class="container text-center">
            <a href="/cuenta" class="text-light">Tu cuenta</a>
            <p class="mb-0">ToolBox Admin</p>
            <p class="mb-0">© 2024 ToolBox. Todos los derechos reservados.</p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Scripts personalizados -->
    <script src="/js/inventario.js"></script>
    <script src="/js/notificacion.js"></script>
    <script src="/js/admin.js"></script>

</body>
</html>