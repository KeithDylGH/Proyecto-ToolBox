<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToolBox Admin - Gestión de Categorías</title>
  <link rel="icon" type="image/x-icon" href="/img/logo/LogoPagina.png">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/cuenta.css">
  <link rel="stylesheet" href="/css/notificacion.css">
  <link rel="stylesheet" href="/css/loader.css">
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Header -->
  <header style="background-color: #666F88; padding: 10px 0;">
    <nav class="navbar navbar-expand-lg" style="padding: 0 2.5rem; font-size: 1.1rem;">
      <div class="container-fluid d-flex">
        <a class="text-light navbar-brand" href="/admin/inventario" style="display: inline-block; margin-right: 25px;">
          <img src="/img/logo/Logo trazo 180.png" alt="Logo" width="30" height="24" class="d-inline-block align-text-top">
          ToolBox Admin
        </a>
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link text-white active" aria-current="page" href="/admin/inventario">Inventario</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-white active" aria-current="page" href="/">Inicio</a>
            </li>
            <!-- Opciones de Categoría -->
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Categoría</a>
              <ul class="dropdown-menu">
                <% if (categorias && categorias.length > 0) { %>
                  <% categorias.forEach(categoria => { %>
                    <li><a class="dropdown-item" href="/tienda/<%= categoria._id %>"><%= categoria.nombre %></a></li>
                  <% }) %>
                <% } else { %>
                  <li><a class="dropdown-item" href="#">No hay categorías disponibles</a></li>
                <% } %>
              </ul>
            </li>

            <!-- Usuario Logeado -->
            <% if (CUsuario) { %>
              <li class="nav-item">
                <a class="nav-link text-white" href="/cuenta"><%= CUsuario.usuario %></a>
              </li>
              <li class="nav-item">
                <a class="nav-link text-white" href="/logout">Cerrar sesión</a>
              </li>
            <% } else { %>
              <li class="nav-item">
                <a class="nav-link text-white" id="login" href="/login">Iniciar sesión</a>
              </li>
              <li class="nav-item">
                <a class="nav-link text-white" id="register" href="/registrar">Registrarse</a>
              </li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <!-- Contenido principal -->
  <div class="container mt-5">
    <main class="px-5 py-2">
      <h1 class="text-center">Gestión de Categorías</h1>

      <!-- Mensaje de notificación -->
      <div id="notification" class="alert alert-success d-none" role="alert"></div>

      <!-- Formulario para agregar categoría -->
      <div class="d-flex justify-content-center mt-4">
        <div class="w-75">
          <div class="card shadow overflow-hidden sm:rounded-lg border-b border-gray-200">
            <div class="bg-white p-3">
              <form id="formularioCategoria" method="POST" action="/api/categorias">
                <div class="mb-4">
                  <label class="form-label" for="nombreCategoria">Nombre de la Categoría</label>
                  <input class="form-control" id="nombreCategoria" name="nombre" type="text" placeholder="Nombre de la Categoría" required />
                </div>
                <button type="submit" class="btn btn-primary">Agregar Categoría</button>
              </form>
              <!-- Loader -->
              <div id="loader" style="display: none;">Cargando...</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Lista de Categorías -->
      <div class="mt-5">
        <h3>Lista de Categorías</h3>
        <ul class="list-group">
          <% if (categorias && categorias.length > 0) { %>
            <% categorias.forEach(function(categoria) { %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><%= categoria.numero %>. <%= categoria.nombre %></span>
                <div class="d-flex">
                  <form action="/api/categorias/<%= categoria._id %>" method="POST" class="d-flex me-2">
                    <input type="hidden" name="_method" value="PUT">
                    <input type="text" name="nombre" class="form-control" value="<%= categoria.nombre %>" required>
                    <button type="submit" class="btn btn-secondary ms-2">Actualizar</button>
                  </form>
                  <form action="/api/categorias/<%= categoria._id %>" method="POST" style="display:inline;">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                  </form>
                </div>
              </li>
            <% }); %>
          <% } else { %>
            <li class="list-group-item">No hay categorías disponibles.</li>
          <% } %>
        </ul>
      </div>
    </main>
  </div>

  <!-- Mini Loader en la esquina superior derecha -->
  <div class="mini-loader-overlay" id="miniLoaderOverlay" style="display: none;">
    <div class="mini-loader"></div>
  </div>

  <!-- Footer -->
  <footer class="mt-auto py-3 bg-dark text-light">
    <div class="container text-center">
      <a href="/cuenta" class="text-light">Tu cuenta</a>
      <p class="mb-0">ToolBox Admin</p>
      <p class="mb-0">© 2024 ToolBox. Todos los derechos reservados.</p>
    </div>
  </footer>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/cuenta.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/notificacion.js"></script>
  <script src="/js/categoriaN.js"></script>
</body>
</html>