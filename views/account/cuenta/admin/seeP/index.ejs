<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ToolBox - Ver inventario</title>

    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/cuenta.css">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/loader.css"> <!-- Agregado para el loader -->

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700&display=swap" rel="stylesheet">
</head>
<body>
    <header style="background-color: #666F88; padding: 10px 0;">
        <nav class="navbar navbar-expand-lg" style="padding: 0 2.5rem; font-size: 1.1rem;">
            <div class="container-fluid">
                <a class="text-light navbar-brand" href="/" style="display: inline-block; margin-right: 25px;">
                    <img src="/img/logo/Logo trazo 180.png" alt="Logo" width="30" height="24" class="d-inline-block align-text-top">
                    ToolBox Admin
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon" style="color: #fff;"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white active" aria-current="page" href="/">Inicio</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Categoría
                            </a>
                            <ul class="dropdown-menu">
                                <% if (categorias && categorias.length > 0) { %>
                                    <% categorias.forEach(categoria => { %>
                                        <li><a class="dropdown-item" href="/tienda/<%= categoria._id %>"><%= categoria.nombre %></a></li>
                                    <% }) %>
                                <% } else { %>
                                    <li><a class="dropdown-item" href="#">No hay categorías disponibles</a></li>
                                <% } %>
                            </ul>
                        </li>
    
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#carritoModal">
                                <img src="/img/icono/carrito de compras.png" alt="carrito" style="height: 30px;" />
                            </a>
                            <div class="modal fade" id="carritoModal" tabindex="-1" aria-labelledby="carritoModalLabel" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title text-black" id="carritoModalLabel">Tu carrito de compras</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <ul id="carritoList" class="list-group">
                                                <!-- Aquí se cargarán dinámicamente los productos del carrito -->
                                            </ul>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                            <a type="button" href="/cuenta/carrito" class="btn btn-primary">Más detalles</a>
                                            <button type="button" id="vaciarCarrito" class="btn btn-warning">Vaciar carrito</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
    
                        <% if (CUsuario) { %>
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/cuenta"><%= CUsuario.nombre %></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/logout">Cerrar sesión</a>
                            </li>
                        <% } else { %>
                            <li class="nav-item">
                                <a class="nav-link text-white" id="login" href="/login">Iniciar sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" id="register" href="/registrar">Registrarse</a>
                            </li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </nav>
    </header>    

    <section class="container mt-4">
        <div class="py-4">
            <h2 class="text-center">Mira los productos disponibles</h2>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Precio</th>
                            <th>Categoría</th>
                            <th>Descripción</th>
                            <th>Imagen</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% productos.forEach(producto => { 
                            const categoria = categorias.find(c => c._id && producto.categoria && c._id.toString() === producto.categoria.toString());
                            const categoriaIndex = categoria ? categorias.indexOf(categoria) + 1 : 'No asignada';
                        %>
                            <tr>
                                <td><%= producto.nombre %></td>
                                <td><%= producto.precio %> $</td>
                                <td>
                                    <% if (categoria) { %>
                                        <%= categoria.nombre %> (ID: <%= categoriaIndex %>)
                                    <% } else { %>
                                        Categoría no asignada
                                    <% } %>
                                </td>
                                <td><%= producto.descripcion %></td>
                                <td>
                                    <% if (producto.imagen && producto.imagen.data !== '') { %>
                                        <img src="<%= producto.imagen.data %>" alt="Imagen del producto" class="img-thumbnail mb-3" style="max-width: 100px;">
                                    <% } else { %>
                                        Sin imagen
                                    <% } %>                                    
                                </td>
                                <td>
                                    <a href="/inventario/editar/<%= producto._id %>" class="btn btn-warning btn-sm">Editar</a>
                                    <button class="btn btn-danger btn-sm btn-eliminar" data-id="<%= producto._id %>">Eliminar</button>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>                                        
                </table>
            </div>
        </div>
    </section>

    <!-- Loader Overlay -->
    <div class="loader-overlay" id="loader" style="display: none;">
        <div class="loader"></div>
    </div>

    <div class="mini-loader-overlay" id="mini-loader" style="display: none;">
        <div class="mini-loader"></div>
    </div>

    <footer class="mt-auto py-3 bg-dark text-light">
        <div class="container text-center">
            <a href="/cuenta" class="text-light">Sobre nosotros</a>
            <p class="mb-0">© 2024 ToolBox. Todos los derechos reservados.</p>
            <p class="mb-0">ToolBox Admin</p>
        </div>
    </footer>
    

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Scripts personalizados -->
    <script src="/js/inventario.js"></script>
    <script src="/js/cuenta.js"></script>
    <script src="/js/admin.js"></script>

</body>
</html>