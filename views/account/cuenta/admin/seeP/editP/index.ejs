<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Producto - ToolBox Admin</title>

    <link rel="icon" type="image/x-icon" href="/img/logo/LogoPagina.png">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/cuenta.css">
    <link rel="stylesheet" href="/css/notificacion.css">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/loader.css"> <!-- Agregado para el loader -->
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700&display=swap" rel="stylesheet">
</head>
<body>
    <header style="background-color: #666F88; padding: 10px 0;">
        <nav class="navbar navbar-expand-lg" style="padding: 0 2.5rem; font-size: 1.1rem;">
            <div class="container-fluid d-flex">
                <a class="text-light navbar-brand" href="/admin/inventario" style="display: inline-block; margin-right: 25px;">
                    <img src="/img/logo/Logo trazo 180.png" alt="Logo" width="30" height="24" class="d-inline-block align-text-top">
                    ToolBox Admin
                </a>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white active" aria-current="page" href="/">Inicio</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Categoría
                            </a>
                            <ul class="dropdown-menu">
                                <% if (categorias && categorias.length > 0) { %>
                                    <% categorias.forEach(categoria => { %>
                                        <li><a class="dropdown-item" href="/tienda/<%= categoria._id %>"><%= categoria.nombre %></a></li>
                                    <% }) %>
                                <% } else { %>
                                    <li><a class="dropdown-item" href="#">No hay categorías disponibles</a></li>
                                <% } %>
                            </ul>
                        </li>
    
                        <% if (CUsuario) { %>
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/cuenta"><%= CUsuario.usuario %></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/logout">Cerrar sesión</a>
                            </li>
                        <% } else { %>
                            <li class="nav-item">
                                <a class="nav-link text-white" id="login" href="/login">Iniciar sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" id="register" href="/registrar">Registrarse</a>
                            </li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </nav>
    </header>    

<!-- Loader -->
<div class="loader-overlay" style="display: none;">
    <div class="loader"></div>
</div>

<!-- Notificación -->
<div class="notification"></div>


    <section class="container mt-4">
        <h2 class="text-center mb-4">Editar Producto</h2>
        <form action="/inventario/editar/<%= producto._id %>" method="POST" enctype="multipart/form-data" class="p-4 border rounded shadow">
            <div class="mb-3">
                <label for="nombre" class="form-label">Nombre</label>
                <input type="text" class="form-control" id="nombre" name="nombre" value="<%= producto.nombre %>" required>
            </div>
            <div class="mb-3">
                <label for="precio" class="form-label">Precio</label>
                <input type="number" class="form-control" id="precio" name="precio" value="<%= producto.precio %>" required>
            </div>
            <div class="mb-3">
                <label for="categoria" class="form-label">Categoría</label>
                <select class="form-select" id="categoria" name="categoria">
                    <% categorias.forEach(categoria => { %>
                        <option value="<%= categoria._id %>" <% if (categoria._id === producto.categoria) { %>selected<% } %>><%= categoria.nombre %></option>
                    <% }); %>
                </select>
            </div>
            <div class="mb-3">
                <label for="descripcion" class="form-label">Descripción</label>
                <textarea class="form-control" id="descripcion" name="descripcion" rows="3" required><%= producto.descripcion %></textarea>
            </div>
            <div class="mb-3">
                <label for="imagenActual" class="form-label">Imagen Actual</label>
                <div>
                    <% if (producto.imagen && producto.imagen.data !== '') { %>
                        <img src="<%= producto.imagen.data %>" alt="Imagen del producto" class="img-thumbnail mb-3" style="max-width: 100px;">
                    <% } else { %>
                        Sin imagen
                    <% } %>
                </div>
                <label for="nuevaImagen" class="form-label">Seleccionar Nueva Imagen</label>
                <input type="file" class="form-control" id="nuevaImagen" name="nuevaImagen">
            </div>
            <div class="text-center mt-4">
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                <a href="/admin/inventario" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </section>

    <footer class="mt-auto py-3 bg-dark text-light">
        <div class="container text-center">
            <a href="/cuenta" class="text-light">Tu cuenta</a>
            <p class="mb-0">ToolBox Admin</p>
            <p class="mb-0">© 2024 ToolBox. Todos los derechos reservados.</p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/editar.js"></script>
    <script src="/js/notificacion.js"></script>
</body>
</html>