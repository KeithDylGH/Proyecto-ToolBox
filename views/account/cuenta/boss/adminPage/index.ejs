<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ToolBox - Admin</title>
    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/cuenta.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
</head>
<body>

    <div>
        <section>
            <!-- Sidebar -->
            <div class="sidebar">
                <a href="#" id="homeBtn"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>
                <a class="active sidebar_btn" href="#" id="client">Inicio</a>
                <a href="#general" id="pagBtn">Ir a la Pág. Principal</a>
                <a href="#carrito" id="carritoBtn">Carrito</a>
                <a href="#contacto" id="contactoBtn">Servicio al Cliente</a>
                <a href="#inventario" id="inventarioBtn">Inventario</a>
                <a href="#configuracion" id="configuracionBtn">Configuración</a>
                <button class="Log-Out" id="logout"><a href="#">Cerrar sesión</a></button>
            </div>
        </section>

        <section class="interfaz">
            <div class="container">
                <h1>Gestión de Usuarios</h1>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Rol Actual</th>
                                <th>Asignar Rol</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% usuarios.forEach(usuario => { %>
                                <tr>
                                    <td><%= usuario.nombre %> <%= usuario.apellido %></td>
                                    <td><%= usuario.correo %></td>
                                    <td><%= usuario.rol %></td>
                                    <td>
                                        <form action="/jefe/actualizarRol" method="POST">
                                            <input type="hidden" name="userId" value="<%= usuario._id %>">
                                            <select name="rol" class="form-select">
                                                <option value="user" <%= usuario.rol === 'user' ? 'selected' : '' %>>User</option>
                                                <option value="admin" <%= usuario.rol === 'admin' ? 'selected' : '' %>>Admin</option>
                                                <option value="boss" <%= usuario.rol === 'boss' ? 'selected' : '' %>>Boss</option>
                                            </select>
                                            <button type="submit" class="btn btn-primary mt-2">Actualizar</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>

    <script src="/js/cuenta.js"></script>
    <script src="/js/admin.js"></script>
    <script src="/js/logout.js"></script>
</body>
</html>