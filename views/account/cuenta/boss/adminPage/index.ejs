<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ToolBox - Cuenta</title>

    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/cuenta.css">
    
    <!--BOOTSTRAP-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
</head>
<body>

    <div>
        <section>
            <!--Sidebar-->
      
            <div class="sidebar">
              <a href="#" id="homeBtn"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>
      
              <a href="/cuenta" id="client">Inicio</a>
              <a href="/" id="pagBtn">Ir a la Pág. Principal</a>
              <a href="/cuenta/contacto" id="contactoBtn">Servicio al Cliente</a>
              <a href="/cuenta/carrito" id="carritoBtn">Carrito</a>
              <a href="/cuenta/configuracion" id="configuracionBtn">Configuración</a>
      
              <% if (CUsuario && CUsuario.rol === 'boss') { %>
                <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
                <a class="active sidebar_btn" href="/jefe/permisos" id="permisosBtn">Permisos</a>
              <% } else if (CUsuario && CUsuario.rol === 'admin') { %>
                <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
              <% } %>
      
              <button class="Log-Out" id="logout"><a href="#">Cerrar sesión</a></button>
            </div>
      
          </section>

        <section class="interfaz">
            <div class="container">
                <div class="content">
                    <!-- INICIO -->
                    <div class="inicio">
                        <div class="card bg-dark text-white shadow-lg" style="padding: 5rem;">
                            <div class="card-img-overlay" style="background-color: #5e3b3b;
                                background: rgb(94,59,59);
                                background: linear-gradient(153deg, rgba(94,59,59,1) 25%, rgba(52,44,44,1) 100%);">
                                <div class="welcomeMsg">
                                    <h3 class="card-title text-light">Permisos</h3>
                                    <p class="card-text-overlay">Administra usuarios, baneando, quitando y agregando Administradores</p>
                                </div>
                            </div>
                        </div>

                        <div class="container mt-4">
                            <h2>Gestión de Usuarios</h2>
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Nombre de Usuario</th>
                                        <th>Nombres</th>
                                        <th>Apellidos</th>
                                        <th>Cédula</th>
                                        <th>Teléfono</th>
                                        <th>Correo</th> <!-- Nueva columna para el correo -->
                                        <th>Rol</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% users.forEach(user => { %>
                                        <tr>
                                            <td><%= user.usuario %></td>
                                            <td><%= user.nombre %></td>
                                            <td><%= user.apellido %></td>
                                            <td><%= user.cedula %></td>
                                            <td><%= user.numero %></td>
                                            <td><%= user.correo %></td> <!-- Mostrar correo del usuario -->
                                            <td><%= user.rol %></td>
                                            <td>
                                                <% if (user.rol === 'boss') { %>
                                                    <!-- El usuario con rol 'boss' no puede ser modificado -->
                                                    <button class="btn btn-secondary btn-sm" disabled>Protegido</button>
                                                <% } else { %>
                                                    <% if (user.rol === 'admin') { %>
                                                        <button class="btn btn-warning btn-sm" onclick="changeRole('<%= user._id %>', 'user')">Revocar Admin</button>
                                                    <% } else { %>
                                                        <button class="btn btn-success btn-sm" onclick="changeRole('<%= user._id %>', 'admin')">Promover a Admin</button>
                                                    <% } %>
                                                    <button class="btn btn-danger btn-sm" onclick="banUser('<%= user._id %>')">Banear</button>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>                            
                        </div>
                        
                    </div>
                </div>
            </div>
        </section>
    </div>

    <script src="/js/cuenta.js"></script>
    <script src="/js/admin.js"></script>
    <script src="/js/logout.js"></script>

    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>
</body>
</html>