<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToolBox - Cuenta/Cliente Carrito</title>

  <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png">
  <link rel="stylesheet" href="/css/cuenta.css">
  <link rel="stylesheet" href="/css/carrito.css">
  <link rel="stylesheet" href="/css/notificacion.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap"
    rel="stylesheet">
</head>

<body>

  <div>
    <section>
      <!--Sidebar-->
      <div class="sidebar">
        <a href="#" id="homeBtn"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>
        <a href="#" id="client">Inicio</a>
        <a href="#general" id="pagBtn">Ir a la Pág. Principal</a>
        <a class="active sidebar_btn " href="#carrito" id="carritoBtn">Carrito</a>
        <a href="#contacto" id="contactoBtn">Servicio al Cliente</a>
        <a href="#configuracion" id="configuracionBtn">Configuración</a>
        <button class="Log-Out" id="logout"><a href="#">Cerrar sesión</a></button>
      </div>
    </section>

    <section class="interfaz">
      <div class="container">
        <div class="content">
          <h1>Tu Carrito</h1>

          <!-- Mostrar el carrito en cualquier página -->
          <% if (user && user.carrito && user.carrito.length > 0) { %>
            <ul id="carritoList" class="list-group">
              <% if (user && user.carrito && user.carrito.length > 0) { %>
                <% user.carrito.forEach(item => { %>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                      <img src="<%= item.producto.imagenUrl %>" alt="<%= item.producto.nombre %>" class="img-thumbnail" style="width: 50px; height: 50px;">
                      <strong><%= item.producto.nombre %></strong> - <%= item.producto.categoria %>
                    </div>
                    <span class="badge badge-primary badge-pill">Cantidad: <%= item.cantidad %></span>
                    <span>Precio: $<%= item.producto.precio %></span>
                    <form action="/carrito/eliminar/<%= item.producto._id %>" method="POST" style="display:inline;">
                      <button class="btn btn-danger btn-sm">Eliminar</button>
                    </form>
                  </li>
                <% }) %>
              <% } else { %>
                <li class="list-group-item">No hay productos en el carrito.</li>
              <% } %>
            </ul>            
            <form action="/carrito/vaciar" method="POST">
              <button type="submit" class="btn btn-warning">Vaciar Carrito</button>
            </form>
            <a href="/checkout" class="btn btn-primary">Proceder al Pago</a>
          <% } else { %>
            <p>No hay productos en el carrito.</p>
          <% } %>                         

          <!-- Botón para vaciar el carrito -->
          <% if (user && user.carrito && user.carrito.length > 0) { %>
            <form action="/carrito/vaciar" method="POST">
              <button type="submit" class="btn btn-warning">Vaciar Carrito</button>
            </form>
            <a href="/checkout" class="btn btn-primary">Proceder al Pago</a>
          <% } %>
        </div>
      </div>
    </section>

  </div>

  <footer>
    <div class="text-right p-3 text-muted" style="background-color:#2d1c1c; color: #fff;">
      © 2024 Copyright:
      <a class="link text-body" href="/views/home/index.html">ToolBox</a>
    </div>
  </footer>

  <script src="/js/cuenta.js"></script>
  <script src="/js/home.js"></script>
  <script src="/js/client.js"></script>
  <script src="/js/logout.js"></script>

  <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
    integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
    integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7Hfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
    integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
    crossorigin="anonymous"></script>
</body>

</html>