<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToolBox - Tu Carrito</title>

  <link rel="stylesheet" href="/css/menuCuenta.css">
  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="icon" type="image/x-icon" href="/img/logo/LogoPagina.png">

  <link rel="stylesheet" href="/css/notificacion.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
  <div>
    <!--NOTIFICACION-->
  <div class="notification d-none"></div>
  <section>
    <!--Sidebar-->
  
    <div class="sidebar">
      <a href="/"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>
  
      <a href="/cuenta" id="client">Inicio</a>
      <a href="/" id="pagBtn">Ir a la Pág. Principal</a>
      <a class="active sidebar_btn" href="/cuenta/carrito" id="carritoBtn">Carrito</a>
      <a href="/cuenta/atencion" id="contactoBtn">Servicio al Cliente</a>
      <a href="/cuenta/configuracion" id="configuracionBtn">Configuración</a>
  
      <% if (CUsuario && CUsuario.rol === 'boss') { %>
        <a href="/admin/notificacion">Notificación</a>
        <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
        <a href="/jefe/permisos" id="permisosBtn">Permisos</a>
      <% } else if (CUsuario && CUsuario.rol === 'admin') { %>
        <a href="/admin/notificacion">Notificación</a>
        <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
      <% } %>
  
      <button class="Log-Out"><a href="/logout">Cerrar sesión</a></button>
    </div>
  
  </section>

    <section class="interfaz">
      <div class="container mt-4">
          <div class="content">
              <!-- Encabezado del Carrito -->
    <div class="card bg-dark text-white" style="padding: 5rem; margin-bottom: 1rem;">
      <div class="card-img-overlay"
          style="background-color: #844915;
                  background: rgb(99, 58, 20);
                  background: linear-gradient(153deg, rgb(127, 70, 24) 25%, rgb(128, 49, 12) 100%);">
          <h3 class="card-title text-light">Gestiona tu Carrito</h3>
          <p class="card-text">Aquí puedes ver todos los productos que has agregado a tu carrito. Puedes proceder al pago o vaciar el carrito si lo deseas.</p>
      </div>
    </div>

              <ul id="carritoList" class="list-group mb-3 bg-white">
                <!-- El carrito se cargará dinámicamente mediante carritoC.js -->
              </ul>
              <button id="vaciarCarrito" class="btn btn-warning">Vaciar Carrito</button>
              <hr>
              <h3 id="totalMonto">Monto Total: $0.00</h3>
              <a href="/compra" class="btn btn-success">Proceder al Pago</a>
          </div>
      </div>
    </section>  
  </div>

  <footer>
    <div class="text-right p-3 text-muted" style="background-color:#2d1c1c; color: #fff;">
      © 2024 Copyright: <a class="link text-body" href="#">ToolBox</a>
    </div>
  </footer>

  <script src="/js/carritoC.js"></script>
  <script src="/js/client.js"></script>
  <script src="/js/notificacion.js"></script>
  <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"></script>
</body>

</html>