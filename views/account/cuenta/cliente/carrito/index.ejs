<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tu Carrito</title>
  <link rel="stylesheet" href="/css/cuenta.css">
  <link rel="stylesheet" href="/css/carrito.css">
  <link rel="stylesheet" href="/css/notificacion.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
  <div>
    <section>
      <!--Sidebar-->
    
      <div class="sidebar">
        <a href="#" id="homeBtn"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>
    
        <a href="/cuenta" id="client">Inicio</a>
        <a href="/" id="pagBtn">Ir a la Pág. Principal</a>
        <a class="active sidebar_btn" href="/cuenta/carrito" id="carritoBtn">Carrito</a>
        <a href="/cuenta/atencion" id="contactoBtn">Servicio al Cliente</a>
        <a href="/cuenta/configuracion" id="configuracionBtn">Configuración</a>
    
        <% if (CUsuario && CUsuario.rol === 'boss') { %>
          <a href="/cuenta/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
          <a href="/jefe/permisos" id="permisosBtn">Permisos</a>
        <% } else if (CUsuario && CUsuario.rol === 'admin') { %>
          <a href="/admin/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
        <% } %>
    
        <button class="Log-Out" id="logout"><a href="#">Cerrar sesión</a></button>
      </div>
    
    </section>

    <section class="interfaz">
      <div class="container">
          <div class="content">
              <h1>Tu Carrito</h1>
              <ul id="carritoList">
                <!-- El carrito se cargará dinámicamente mediante carritoC.js -->
              </ul>
              <button id="vaciarCarrito" class="btn btn-warning">Vaciar Carrito</button>
              <hr>
              <h3 id="totalMonto">Monto Total: $0.00</h3>
              <a href="/compra" class="btn btn-success">Proceder al Pago</a>
          </div>
      </div>
    </section>  
  </div>

  <footer>
    <div class="text-right p-3 text-muted" style="background-color:#2d1c1c; color: #fff;">
      © 2024 Copyright: <a class="link text-body" href="#">ToolBox</a>
    </div>
  </footer>

  <script src="/js/cuenta.js"></script>
  <script src="/js/carritoC.js"></script>
  <script src="/js/client.js"></script>
  <script src="/js/logout.js"></script>
  <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"></script>
</body>

</html>