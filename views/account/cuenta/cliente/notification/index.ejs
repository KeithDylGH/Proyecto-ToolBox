<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notificaciones de Pago</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>

    <section>
        <!--Sidebar-->
  
        <div class="sidebar">
          <a href="#" id="homeBtn"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>
  
          <a href="/cuenta" id="client">Inicio</a>
          <a href="/" id="pagBtn">Ir a la Pág. Principal</a>
          <a href="/cuenta/carrito" id="carritoBtn">Carrito</a>
          <a href="/cuenta/contacto" id="contactoBtn">Servicio al Cliente</a>
          <a href="/cuenta/configuracion" id="configuracionBtn">Configuración</a>
  
          <% if (CUsuario && CUsuario.rol === 'boss') { %>
            <a class="active sidebar_btn" href="/cuenta/notificacion">Notificacion</a>
            <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
            <a href="/jefe/permisos" id="permisosBtn">Permisos</a>
          <% } else if (CUsuario && CUsuario.rol === 'admin') { %>
            <a class="active sidebar_btn" href="/cuenta/notificacion">Notificacion</a>
            <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
          <% } %>
  
          <button class="Log-Out" id="logout"><a href="#">Cerrar sesión</a></button>
        </div>
  
      </section>

  <div class="container mt-5">
    <h1>Notificaciones de Pago</h1>

    <div class="list-group">
      <% notificaciones.forEach((notificacion, index) => { %>
        <a href="#" class="list-group-item list-group-item-action" data-bs-toggle="modal" data-bs-target="#detalleModal-<%= index %>">
          <h5 class="mb-1"><%= notificacion.usuarioNombre %> (<%= notificacion.usuarioCorreo %>)</h5>
          <small>Fecha: <%= notificacion.fecha.toLocaleDateString() %></small>
        </a>

        <!-- Modal -->
        <div class="modal fade" id="detalleModal-<%= index %>" tabindex="-1" aria-labelledby="detalleModalLabel" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="detalleModalLabel">Detalle de la compra</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                <p><strong>Productos:</strong> <%= notificacion.productos %></p>
                <p><strong>Método de pago:</strong> <%= notificacion.metodoPago %></p>
                <p><strong>Total:</strong> <%= notificacion.total %></p>
                <p><strong>Fecha:</strong> <%= notificacion.fecha.toLocaleDateString() %></p>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>