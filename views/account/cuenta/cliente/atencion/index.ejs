<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToolBox - Cuenta/Cliente/Servicio al cliente</title>

  <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png">
  <link rel="stylesheet" href="/css/cuenta.css">
  <link rel="stylesheet" href="/css/servicio.css">

  <!--BOOTSTRAP-->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
</head>

<body>

  <div>
    <section>
      <!--Sidebar-->
      <div class="sidebar">
        <a href="#" id="homeBtn"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>

        <a href="/cuenta" id="client">Inicio</a>
        <a href="/" id="pagBtn">Ir a la Pág. Principal</a>
        <a href="/cuenta/carrito" id="carritoBtn">Carrito</a>
        <a class="active sidebar_btn" href="/cuenta/atencion" id="contactoBtn">Servicio al Cliente</a>
        <a href="/cuenta/configuracion" id="configuracionBtn">Configuración</a>

        <% if (CUsuario && CUsuario.rol === 'boss') { %>
          <a href="/admin/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
          <a href="/jefe/permisos" id="permisosBtn">Permisos</a>
        <% } else if (CUsuario && CUsuario.rol === 'admin') { %>
          <a href="/admin/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
        <% } %>

        <button class="Log-Out" id="logout"><a href="#">Cerrar sesión</a></button>
      </div>
    </section>

    <section class="interfaz">
      <div class="container">
        <div class="content">
          <!-- INICIO -->
          <div class="inicio">
            <div class="card bg-dark text-white" style="padding: 5rem;">
              <div class="card-img-overlay" style="background-color: #5e3b3b;
                              background: rgb(94,59,59);
                              background: linear-gradient(153deg, rgba(94,59,59,1) 25%, rgba(52,44,44,1) 100%);">
                <div class="welcomeMsg">
                  <% if (CUsuario && CUsuario.rol === 'admin') { %>
                    <h3 class="card-title text-light">Bienvenido <%= CUsuario.nombre %>!</h3>
                    <p class="card-text-overlay">Administra productos, usuarios y más con el modo <%= CUsuario.rol.charAt(0).toUpperCase() + CUsuario.rol.slice(1) %></p>
                  <% } else if (CUsuario && CUsuario.rol === 'boss') { %>
                    <h3 class="card-title text-light">Bienvenido <%= CUsuario.nombre %>!</h3>
                    <p class="card-text-overlay">Administra la página, usuarios y productos con el modo <%= CUsuario.rol.charAt(0).toUpperCase() + CUsuario.rol.slice(1) %></p>
                  <% } else if (CUsuario) { %>
                    <h3 class="card-title text-light">¡Bienvenido <%= CUsuario.nombre %>!</h3>
                    <p class="card-text-overlay">Disfruta las funciones exclusivas de un cliente en ToolBox.</p>
                  <% } else { %>
                    <h3 class="card-title text-light">¡Bienvenido Usuario!</h3>
                    <p class="card-text-overlay">Tu rol no está definido. Por favor, contacta al soporte.</p>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="d-flex flex-column align-items-center">
              <h3 class="mt-4">Servicio al Cliente</h3>
              <div class="d-flex justify-content-center">
                <div class="card" style="width: 14rem; border-radius: .5rem;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2">
                      <img src="/img/icono/whatsapp.png" alt="Contáctanos" width="50px">
                      Contáctanos
                    </h5>
                    <p class="card-text">Si tienes alguna falla o duda, no dudes en contactarnos.</p>
                    <a href="https://wa.me/+4126378817" target="_blank" class="btn btn-success">WhatsApp</a>
                  </div>
                </div>

                <div class="card" style="width: 14rem; border-radius: .5rem;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2">
                      <img src="/img/icono/instagram.png" alt="Instagram" width="50px">
                      Instagram
                    </h5>
                    <p class="card-text">Síguenos en Instagram para más novedades.</p>
                    <a href="https://instagram.com" target="_blank" class="btn btn-danger">Instagram</a>
                  </div>
                </div>

                <% if (CUsuario && (CUsuario.rol === 'admin' || CUsuario.rol === 'boss')) { %>
                  <div class="card" style="width: 14rem; border-radius: .5rem; background-color: #007bff;">
                    <div class="card-body">
                      <h5 class="card-subtitle mb-2 mt-2 text-light">
                        <img src="/img/icono/apoyo-tecnico.png" alt="Contáctanos" width="50px">
                        Soporte
                      </h5>
                      <p class="card-text" style="color: white;">Habla con el programador para cualquier duda o problema.</p>
                      <a href="https://wa.me/+4126378817" target="_blank" class="btn btn-light">Hablar</a>
                    </div>
                  </div>

                  <div class="card" style="width: 14rem; border-radius: .5rem;"></div>
                    <div class="card-body">
                      <h5 class="card-subtitle mb-2 mt-2">
                        <img src="/img/icono/gmail.png" alt="Gmail" width="50px">
                        Gmail
                      </h5>
                      <p class="card-text">Gmail del proyecto.</p>
                      <a href="mailto:toolboxproyecto@gmail.com" target="_blank" class="text-black btn btn-light">Gmail</a>
                    </div>
                  </div>
                <% } %>
              </div>

              <h3 class="mt-4">Métodos de Pago Disponibles</h3>
              <div class="d-flex justify-content-center">
                <div class="card" style="width: 14rem; border-radius: .5rem;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2">
                      <img src="/img/icono/bdv.png" alt="Pago Móvil" width="50px">
                      Pago Móvil
                    </h5>
                    <p class="card-text">Realiza tus pagos fácilmente con BDV.</p>
                  </div>
                </div>

                <div class="card" style="width: 14rem; border-radius: .5rem;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2">
                      <img src="/img/icono/zinli.png" alt="Zinli" width="50px">
                      Zinli
                    </h5>
                    <p class="card-text">Usa Zinli para tus transacciones rápidas.</p>
                  </div>
                </div>

                <div class="card" style="width: 14rem; border-radius: .5rem;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2">
                      <img src="/img/icono/transferencia-bancaria.png" alt="Transferencia" width="50px">
                      Transferencia
                    </h5>
                    <p class="card-text">Transfiere fondos con tarjeta de crédito.</p>
                  </div>
                </div>

                <!-- <div class="card" style="width: 14rem; border-radius: .5rem;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2">
                      <img src="/img/icono/paypal.webp" alt="PayPal" width="50px">
                      PayPal
                    </h5>
                    <p class="card-text">Realiza tus pagos de manera segura con PayPal.</p>
                  </div>
                </div> -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script src="/js/servicio.js"></script>
</body>

</html>