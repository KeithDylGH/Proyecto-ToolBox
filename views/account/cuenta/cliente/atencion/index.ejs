<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToolBox - Atención al cliente</title>

  <link rel="stylesheet" href="/css/menuCuenta.css">
  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="icon" type="image/x-icon" href="/img/logo/LogoPagina.png">

  <!--BOOTSTRAP-->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
</head>

<body>

  <div>
    <section>
      <!--Sidebar-->
      <div class="sidebar">
        <a href="/"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>

        <a href="/cuenta" id="client">Inicio</a>
        <a href="/" id="pagBtn">Ir a la Pág. Principal</a>
        <a href="/cuenta/carrito" id="carritoBtn">Carrito</a>
        <a class="active sidebar_btn" href="/cuenta/atencion" id="contactoBtn">Servicio al Cliente</a>
        <a href="/cuenta/configuracion" id="configuracionBtn">Configuración</a>

        <% if (CUsuario && CUsuario.rol === 'boss') { %>
          <a href="/admin/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
          <a href="/jefe/permisos" id="permisosBtn">Permisos</a>
        <% } else if (CUsuario && CUsuario.rol === 'admin') { %>
          <a href="/admin/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
        <% } %>

        <button class="Log-Out"><a href="/logout">Cerrar sesión</a></button>
      </div>
    </section>

    <section class="interfaz" style="margin-left: 50px;">
      <div class="container">
        <div class="content">
          <!-- INICIO -->
          <div class="inicio">
            <div class="card bg-dark text-white" style="padding: 5rem;">
              <div class="card-img-overlay" style="background-color: #205567; background: rgb(11, 53, 62); background: linear-gradient(153deg, rgb(24, 79, 92) 25%, rgb(14, 62, 66) 100%);">
                <div class="welcomeMsg">
                  <% if (CUsuario && CUsuario.rol === 'admin') { %>
                    <h3 class="card-title text-light">Bienvenido <%= CUsuario.nombre %>!</h3>
                    <p class="card-text-overlay">Administra productos, usuarios y más con el modo <%= CUsuario.rol.charAt(0).toUpperCase() + CUsuario.rol.slice(1) %></p>
                  <% } else if (CUsuario && CUsuario.rol === 'boss') { %>
                    <h3 class="card-title text-light">Bienvenido <%= CUsuario.nombre %>!</h3>
                    <p class="card-text-overlay">Administra la página, usuarios y productos con el modo <%= CUsuario.rol.charAt(0).toUpperCase() + CUsuario.rol.slice(1) %></p>
                  <% } else if (CUsuario) { %>
                    <h3 class="card-title text-light">¡Bienvenido <%= CUsuario.nombre %>!</h3>
                    <p class="card-text-overlay">Disfruta de nuestras funciones de servicio al cliente.</p>
                  <% } else { %>
                    <h3 class="card-title text-light">¡Bienvenido Usuario!</h3>
                    <p class="card-text-overlay">Tu rol no está definido. Por favor, contacta al soporte.</p>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="d-flex flex-wrap justify-content-center">
              <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                <div class="card-body">
                  <h5 class="card-subtitle mb-2 mt-2">
                    <img src="/img/icono/contactosN.png" alt="" width="50px">
                    Contactos
                  </h5>
                  <p class="card-text">Contáctanos para resolver tus dudas</p>
                  <a href="/cuenta/atencion" class="card-link">Entrar a contactos</a>
                </div>
              </div>

              <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                <div class="card-body">
                  <h5 class="card-subtitle mb-2 mt-2">
                    <img src="/img/icono/faq.png" alt="" width="50px">
                    Preguntas Frecuentes
                  </h5>
                  <p class="card-text">Encuentra respuestas a tus preguntas más comunes.</p>
                  <a href="/cuenta/faq" class="card-link">Ver Preguntas Frecuentes</a>
                </div>
              </div>

              <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                <div class="card-body">
                  <h5 class="card-subtitle mb-2 mt-2">
                    <img src="/img/icono/soporte.png" alt="" width="50px">
                    Soporte Técnico
                  </h5>
                  <p class="card-text">Recibe asistencia técnica para cualquier problema.</p>
                  <a href="/cuenta/soporte" class="card-link">Obtener Soporte</a>
                </div>
              </div>

              <% if (CUsuario && CUsuario.rol === 'admin') { %>
              <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                <div class="card-body">
                  <h5 class="card-subtitle mb-2 mt-2">
                    <img src="/img/icono/gestion.png" alt="" width="50px">
                    Gestión de Usuarios
                  </h5>
                  <p class="card-text">Administra los usuarios, puedes agregar, editar y eliminar.</p>
                  <a href="/admin/usuarios" class="card-link">Gestionar Usuarios</a>
                </div>
              </div>
              <% } %>

              <% if (CUsuario && CUsuario.rol === 'boss') { %>
              <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                <div class="card-body">
                  <h5 class="card-subtitle mb-2 mt-2">
                    <img src="/img/icono/inventario-disponible.png" alt="" width="50px">
                    Gestión de Permisos
                  </h5>
                  <p class="card-text">Administra los permisos de los usuarios.</p>
                  <a href="/jefe/permisos" class="card-link">Gestionar Permisos</a>
                </div>
              </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <footer class="mt-auto py-3 bg-dark text-light">
      <div class="container text-center">
        <a href="/acerca-de" class="text-light">Sobre nosotros</a>
        <p class="mb-0">© 2024 ToolBox. Todos los derechos reservados.</p>
      </div>
    </footer>
  </div>

  <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
    integrity="sha384-KJ3oAiT1pF2K5Hj69O5ABt3oRAA1G8m2ekqER0g5A3MgbOMPPuEGhZCxgL3F3Jj" crossorigin="anonymous"></script>
</body>

</html>