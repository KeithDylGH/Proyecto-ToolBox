<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToolBox - Atención al cliente</title>

  <link rel="stylesheet" href="/css/menuCuenta.css">
  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="icon" type="image/x-icon" href="/img/logo/LogoPagina.png">

  <!--BOOTSTRAP-->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
</head>

<body>

  <div>
    <section>
      <!--Sidebar-->
      <div class="sidebar">
        <a href="/"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>

        <a href="/cuenta" id="client">Inicio</a>
        <a href="/" id="pagBtn">Ir a la Pág. Principal</a>
        <a href="/cuenta/carrito" id="carritoBtn">Carrito</a>
        <a class="active sidebar_btn" href="/cuenta/atencion" id="contactoBtn">Servicio al Cliente</a>
        <a href="/cuenta/configuracion" id="configuracionBtn">Configuración</a>

        <% if (CUsuario && CUsuario.rol === 'boss') { %>
          <a href="/admin/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
          <a href="/jefe/permisos" id="permisosBtn">Permisos</a>
        <% } else if (CUsuario && CUsuario.rol === 'admin') { %>
          <a href="/admin/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
        <% } %>

        <button class="Log-Out"><a href="/logout">Cerrar sesión</a></button>
      </div>
    </section>

    <section class="interfaz">
      <div class="container-fluid container-md">
        <div class="content">
          <!-- INICIO -->
          <div class="inicio">
            <div class="card bg-dark text-white" style="padding: 5rem;">
              <div class="card-img-overlay" style="background-color: #205567; background: rgb(11, 53, 62); background: linear-gradient(153deg, rgb(24, 79, 92) 25%, rgb(14, 62, 66) 100%);">
                <div class="welcomeMsg">
                  <% if (CUsuario && (CUsuario.rol === 'admin' || CUsuario.rol === 'boss')) { %>
                    <h3 class="card-title text-light">Servicio al Cliente</h3>
                    <p class="card-text-overlay">Si necesitas asistencia, contacta al desarrollador de la pagina, o contacta con el correo de la pagina</p>
                  <% } else if (CUsuario) { %>
                    <h3 class="card-title text-light">Servicio al Cliente</h3>
                    <p class="card-text-overlay">Contáctanos a través de nuestras redes sociales.</p>
                  <% } else { %>
                    <h3 class="card-title text-light">Servicio al Cliente</h3>
                    <p class="card-text-overlay">Tu rol no está definido. Por favor, contacta al soporte.</p>
                  <% } %>
                </div>
              </div>
            </div>
    
            <div class="d-flex flex-wrap justify-content-center mt-4">
              <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                <div class="card-body">
                  <h5 class="card-subtitle mb-2 mt-2">
                    <img src="/img/icono/whatsapp.png" alt="Contáctanos" width="50px">
                    Contáctanos
                  </h5>
                  <p class="card-text">Si tienes alguna falla o duda, no dudes en contactarnos.</p>
                  <a href="https://wa.me/+4126378817" target="_blank" class="btn btn-success">Chatear</a>
                </div>
              </div>
              
              <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                <div class="card-body">
                  <h5 class="card-subtitle mb-2 mt-2">
                    <img src="/img/icono/instagram.png" alt="Instagram" width="50px">
                    Instagram
                  </h5>
                  <p class="card-text">Síguenos en Instagram para más novedades.</p>
                  <a href="https://instagram.com" target="_blank" class="btn btn-danger">Siguenos</a>
                </div>
              </div>
              
              <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                <div class="card-body">
                  <h5 class="card-subtitle mb-2 mt-2">
                    <img src="/img/icono/facebook.png" alt="Facebook" width="50px">
                    Facebook
                  </h5>
                  <p class="card-text">Síguenos en Facebook para nuestras actualizaciones.</p>
                  <a href="https://facebook.com" target="_blank" class="btn btn-primary">Visitanos</a>
                </div>
              </div>
              
              <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                <div class="card-body">
                  <h5 class="card-subtitle mb-2 mt-2">
                    <img src="/img/icono/X.png" alt="X" width="50px">
                    Twitter
                  </h5>
                  <p class="card-text">Síguenos en X para estar al día.</p>
                  <a href="https://X.com" target="_blank" class="btn btn-info">Siguenos</a>
                </div>
              </div>
              
              <% if (CUsuario && (CUsuario.rol === 'admin' || CUsuario.rol === 'boss')) { %>
                <div class="card m-2" style="width: 14rem; border-radius: .5rem; background-color: #007bff;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2 text-light">
                      <img src="/img/icono/apoyo-tecnico.png" alt="Contáctanos" width="50px">
                      Soporte
                    </h5>
                    <p class="card-text" style="color: white;">Habla con el programador para cualquier duda o problema.</p>
                    <a href="https://wa.me/+4126378817" target="_blank" class="btn btn-light">Soporte</a>
                  </div>
                </div>
            
                <!-- Tarjeta de Gmail -->
                <div class="card m-2" style="width: 14rem; border-radius: .5rem;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2">
                      <img src="/img/icono/gmail.png" alt="Gmail" width="50px">
                      Gmail
                    </h5>
                    <p class="card-text">Contáctanos por correo electrónico.</p>
                    <a href="mailto:toolboxproyecto@gmail.com" class="btn btn-danger">Enviar Correo</a>
                  </div>
                </div>
              <% } %>
            </div>
            
            <div class="d-flex flex-column align-items-center">
              <h3 class="mt-4">Métodos de Pago</h3>
              <div class="d-flex flex-wrap justify-content-center">
                <div class="card m-2" style="width: 14rem; border-radius: .5rem; background-color: #e0e0e0;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2">
                      <img src="/img/icono/bdv.png" alt="Pago Móvil" width="50px">
                      Pago Móvil
                    </h5>
                    <p class="card-text">Realiza pagos fáciles y rápidos con Pago Móvil.</p>
                  </div>
                </div>
            
                <div class="card m-2" style="width: 14rem; border-radius: .5rem; background-color: #e0e0e0;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2">
                      <img src="/img/icono/transferencia-bancaria.png" alt="Transferencia" width="50px">
                      Transferencia Bancaria
                    </h5>
                    <p class="card-text">Envía tu pago a través de transferencia bancaria.</p>
                  </div>
                </div>
            
                <div class="card m-2" style="width: 14rem; border-radius: .5rem; background-color: #e0e0e0;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2">
                      <img src="/img/icono/efectivo.jpg" alt="Efectivo" width="50px">
                      Pago en Efectivo
                    </h5>
                    <p class="card-text">Realiza tu pago en efectivo en nuestras oficinas.</p>
                  </div>
                </div>
    
                <!-- Tarjeta para Zinli -->
                <div class="card m-2" style="width: 14rem; border-radius: .5rem; background-color: #e0e0e0;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2">
                      <img src="/img/icono/zinli.png" alt="Zinli" width="50px">
                      Zinli
                    </h5>
                    <p class="card-text">Realiza pagos fáciles y seguros con Zinli.</p>
                  </div>
                </div>
                
              </div>
            </div>            
          </div>
        </div>
      </div>
    </section>    
  </div>
</body>

</html>