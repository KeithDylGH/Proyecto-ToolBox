<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ToolBox - Cuenta/Cliente/Configuracion</title>

    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png">
    <link rel="stylesheet" href="/css/cuenta.css">
    <link rel="stylesheet" href="/css/configuration.css">

    <!--BOOTSTRAP-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
</head>

<body>
    <section>
        <!--Sidebar-->
        <div class="sidebar">
            <a href="#" id="homeBtn"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>
            
            <a class="active sidebar_btn" href="#" id="client">Inicio</a>
            <a href="#general" id="pagBtn">Ir a la Pág. Principal</a>
            <a href="#carrito" id="carritoBtn">Carrito</a>
            <a href="#contacto" id="contactoBtn">Servicio al Cliente</a>
            
            <% if (CUsuario) { %>
                <% if (CUsuario.rol === 'boss') { %>
                    <a href="#inventario" id="inventarioBtn">Inventario</a>
                    <a href="/jefe/permisos" id="permisosBtn">Permisos</a>
                <% } else if (CUsuario.rol === 'admin') { %>
                    <a href="#inventario" id="inventarioBtn">Inventario</a>
                <% } %>
            <% } %>

            <a href="#configuracion" id="configuracionBtn">Configuración</a>
            <button class="Log-Out" id="logout"><a href="#">Cerrar sesión</a></button>
        </div>
    </section>

    <section class="interfaz">
        <div class="container">
            <div class="content">
                <div class="conf">
                    <div class="carrito">
                        <div class="card bg-dark text-white" style="padding: 5rem;">
                            <div class="card-img-overlay" style="background-color: #5e3b3b;
                                background: rgb(94,59,59);
                                background: linear-gradient(153deg, rgb(59, 85, 94) 25%, rgb(44, 52, 52) 100%);">
                                <h3 class="card-title">Configuración</h3>
                                <p class="card-text-overlay">Cambia tus datos (<strong>NO</strong> compartiremos tus cambios a <strong>nadie</strong>)</p>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="rounded-2">
                                <p class="pt-2 text-danger"><strong>NO</strong> compartiremos tus cambios a <strong>nadie</strong> </p>
                            </div>

                            <div class="mb-3">
                                <label for="name" class="form-label">Cambia tu Nombre</label>
                                <input type="text" class="form-control" id="name" placeholder="Nuevo nombre aquí">
                            </div>

                            <div class="mb-3">
                                <label for="lastname" class="form-label">Cambia tu Apellido</label>
                                <input type="text" class="form-control" id="lastname" placeholder="Nuevo apellido aquí">
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">Cambia tu Correo</label>
                                <input type="email" class="form-control" id="email" placeholder="usuario@email.com">
                            </div>

                            <div class="mb-3">
                                <label for="username" class="form-label">Cambia tu Usuario</label>
                                <input type="text" class="form-control" id="username" placeholder="Nuevo Usuario aquí">
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">Cambia tu Contraseña</label>
                                <input type="password" class="form-control" id="password" placeholder="No compartiremos tu contraseña">
                            </div>

                            <div class="mb-3">
                                <label for="phone" class="form-label">Cambia tu Teléfono</label>
                                <input type="tel" class="form-control" id="phone" placeholder="Ejemplo: 0412-0000000">
                            </div>

                            <div class="mb-3">
                                <label for="idnumber" class="form-label">Cambia tu Cédula (No compartiremos tu cédula)</label>
                                <input type="text" class="form-control" id="idnumber" placeholder="Ejemplo: V30999666">
                            </div>

                            <p class="text-muted">En 7 días podrás volver a cambiar los datos</p>
                            <button type="button" class="btn btn-success" id="saveChanges">Guardar todos los cambios</button>

                            <button type="button" class="btn btn-danger mt-3" id="deleteAccount">Eliminar cuenta</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="/js/cuenta.js"></script>
    <script src="/js/client.js"></script>
    <script src="/js/logout.js"></script>

    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-dx5cJ4I5dJXoG8A1z3P1f4vStzKpBd4y0JZwl8WrW2d8Tz5MQ1P1q9wzzf1R3um1"
        crossorigin="anonymous"></script>
</body>

</html>