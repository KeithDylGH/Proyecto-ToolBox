<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToolBox - Configuracion</title>

  <link rel="icon" type="image/x-icon" href="/img/logo/LogoPagina.png">

  <link rel="stylesheet" href="/css/menuCuenta.css">
  <link rel="stylesheet" href="/css/sidebar.css">

  <!--BOOTSTRAP-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap"
    rel="stylesheet">
</head>

<body>

  <div>
    <section>
      <!--Sidebar-->
    
      <div class="sidebar">
        <a href="/"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>
    
        <a href="/cuenta" id="client">Inicio</a>
        <a href="/" id="pagBtn">Ir a la Pág. Principal</a>
        <a href="/cuenta/carrito" id="carritoBtn">Carrito</a>
        <a href="/cuenta/atencion" id="contactoBtn">Servicio al Cliente</a>
        <a class="active sidebar_btn" href="/cuenta/configuracion" id="configuracionBtn">Configuración</a>
    
        <% if (CUsuario && CUsuario.rol === 'boss') { %>
          <a href="/admin/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
          <a href="/jefe/permisos" id="permisosBtn">Permisos</a>
        <% } else if (CUsuario && CUsuario.rol === 'admin') { %>
          <a href="/admin/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
        <% } %>
    
        <button class="Log-Out"><a href="/logout">Cerrar sesión</a></button>
      </div>
    
    </section>

    <section class="interfaz">
      <div class="container">
        <div class="content">

          <div class="conf">

            <div class="carrito">
              <div class="card bg-dark text-white" style="padding: 5rem;">
                <div class="card-img-overlay" style="background-color: #5e3b3b;
                                background: rgb(94,59,59);
                                background: linear-gradient(153deg, rgb(59, 85, 94) 25%, rgb(44, 52, 52) 100%);">
                  <h3 class="card-title">Configuracion</h3>
                  <p class="card-text-overlay">Configura tu cuenta y si quieres cambiar algo</p>
                </div>
              </div>

              <div class="d-flex justify-content-center">
                <div class="card shadow-sm" style="width: 14rem; border-radius: .5rem;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2">
                      <img src="/img/icono/lapiz-de-usuario.png" alt="" width="50px">
                      Cambiar Datos
                    </h5>
                    <p class="card-text">Cambia tu contraseña, usuario o correo</p>
                    <a href="/cuenta/configuracion/editar/" class="card-link">Cambiar datos de Usuario</a>
                  </div>
                </div>
  
                <div class="card shadow-sm" style="width: 14rem; border-radius: .5rem;">
                  <div class="card-body">
                    <h5 class="card-subtitle mb-2 mt-2">
                      <img src="/img/icono/alt-administrador.png" alt="" width="50px">
                      Ver datos actuales
                    </h5>
                    <p class="card-text">Cambia tus datos de pagas, tarjetas, cuenta, etc</p>
                    <a href="/cuenta/configuracion/Ver-usuario" class="card-link">Ver tus datos</a>
                  </div>
                </div>
  
              </div>

              


                    </div>
                  </div>


                </div>
              </div>


            </div>


          </div>
        </div>


    </section>

  </div>

  </div>

  <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
    integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
    integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
    integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
    crossorigin="anonymous"></script>
</body>

</html>