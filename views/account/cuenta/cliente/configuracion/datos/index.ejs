<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToolBox - Configuración</title>
  <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png">
  <link rel="stylesheet" href="/css/cuenta.css">
  <link rel="stylesheet" href="/css/configuration.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
  <div>
    <section>
      <!--Sidebar-->
      <div class="sidebar">
        <a href="#" id="homeBtn"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>
    
        <a href="/cuenta" id="client">Inicio</a>
        <a href="/" id="pagBtn">Ir a la Pág. Principal</a>
        <a href="/cuenta/carrito" id="carritoBtn">Carrito</a>
        <a href="/cuenta/atencion" id="contactoBtn">Servicio al Cliente</a>
        <a class="active sidebar_btn" href="/cuenta/configuracion" id="configuracionBtn">Configuración</a>
    
        <% if (CUsuario && CUsuario.rol === 'boss') { %>
          <a href="/cuenta/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
          <a href="/jefe/permisos" id="permisosBtn">Permisos</a>
        <% } else if (CUsuario && CUsuario.rol === 'admin') { %>
          <a href="/admin/notificacion">Notificación</a>
          <a href="/admin/inventario" id="inventarioBtn">Inventario</a>
        <% } %>
    
        <button class="Log-Out" id="logout"><a href="#">Cerrar sesión</a></button>
      </div>
    </section>

    <section class="interfaz">
      <div class="container">
        <div class="content">
          <h1>TU USUARIO</h1>
          <form id="editUserForm" action="/cuenta/configuracion/editar" method="POST">
            <div class="mb-3">
              <label for="nombre" class="form-label">Nombre</label>
              <input type="text" class="form-control" id="nombre" name="nombre" value="<%= usuario ? usuario.nombre : '' %>" required readonly>
            </div>
            <div class="mb-3">
              <label for="apellido" class="form-label">Apellido</label>
              <input type="text" class="form-control" id="apellido" name="apellido" value="<%= usuario ? usuario.apellido : '' %>" required readonly>
            </div>
            <div class="mb-3">
              <label for="usuario" class="form-label">Usuario</label>
              <input type="text" class="form-control" id="usuario" name="usuario" value="<%= usuario ? usuario.usuario : '' %>" required readonly>
            </div>
            <div class="mb-3">
              <label for="correo" class="form-label">Correo</label>
              <input type="email" class="form-control" id="correo" name="correo" value="<%= usuario ? usuario.correo : '' %>" required readonly>
            </div>
            <div class="mb-3">
              <label for="password" class="form-label">Nueva Contraseña</label>
              <input type="password" class="form-control" id="password" name="password" placeholder="Dejar vacío si no deseas cambiar" readonly>
            </div>
            <div class="mb-3">
              <label for="numero" class="form-label">Número</label>
              <input type="number" class="form-control" id="numero" name="numero" value="<%= usuario ? usuario.numero : '' %>" required readonly>
            </div>
            <div class="mb-3">
              <label for="cedula" class="form-label">Cédula</label>
              <input type="text" class="form-control" id="cedula" name="cedula" value="<%= usuario ? usuario.cedula : '' %>" required readonly>
            </div>
          </form>

          <div class="mb-3">
            <a href="/cuenta/configuracion/editar" class="btn btn-secondary">Editar Datos</a>
            <form action="/cuenta/configuracion/eliminar" method="POST" style="display: inline;">
              <button class="btn btn-danger banUserBtn" data-user-id="<%= usuario._id %>">Eliminar</button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script src="/js/editUser.js"></script>
</body>

</html>