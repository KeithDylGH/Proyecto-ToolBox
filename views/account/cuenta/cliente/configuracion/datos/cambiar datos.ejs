<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ToolBox - Cuenta/Cliente/Configuracion</title>

    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png">

    <link rel="stylesheet" href="/public/css/cuenta.css">
    <link rel="stylesheet" href="/public/css/configuration.css">

    <!--BOOTSTRAP-->
    <!--  <link rel="stylesheet" href="/bootstrap-5.3.3-dist/css/bootstrap.rtl.min.css">
    <script src="/bootstrap-5.3.3-dist/js/bootstrap.bundle.js"></script> -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap"
        rel="stylesheet">
</head>

<body>

    <div>
        <section>
            <!--Sidebar-->

            <div class="sidebar">
                <a href="#" id="homeBtn"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>

                <a href="#" id="client">Inicio</a>
                <a href="#general" id="pagBtn">Ir a la Pág. Principal</a>
                <a href="#carrito" id="carritoBtn">Carrito</a>
                <a href="#contacto" id="contactoBtn">Servicio al Cliente</a>
                <a class="active sidebar_btn" href="#configuracion" id="configuracionBtn">Configuración</a>

                <button class="Log-Out" id="logout"><a href="#">Cerrar sesion
                    </a></button>
            </div>

        </section>

        <section class="interfaz">
            <div class="container">
                <div class="content">

                    <div class="conf">

                        <form id="formEditarUsuario" method="POST" action="/api/usuarios/editar/<%= usuario.id %>">
                            <div class="form-group">
                                <label for="nombre">Nombre:</label>
                                <input type="text" id="nombre" name="nombre" value="<%= usuario.nombre %>" class="form-control" required>
                            </div>
                            <div class="form-group">
                                <label for="apellido">Apellido:</label>
                                <input type="text" id="apellido" name="apellido" value="<%= usuario.apellido %>" class="form-control" required>
                            </div>
                            <div class="form-group">
                                <label for="usuario">Usuario:</label>
                                <input type="text" id="usuario" name="usuario" value="<%= usuario.usuario %>" class="form-control" required>
                            </div>
                            <div class="form-group">
                                <label for="correo">Correo:</label>
                                <input type="email" id="correo" name="correo" value="<%= usuario.correo %>" class="form-control" required>
                            </div>
                            <div class="form-group">
                                <label for="numero">Número de Teléfono:</label>
                                <input type="text" id="numero" name="numero" value="<%= usuario.numero %>" class="form-control">
                            </div>
                            <div class="form-group">
                                <label for="cedula">Cédula:</label>
                                <input type="text" id="cedula" name="cedula" value="<%= usuario.cedula %>" class="form-control">
                            </div>
                            <button type="submit" class="btn btn-primary">Actualizar Datos</button>
                        </form>                        


                    </div>


                </div>
            </div>


        </section>

    </div>

    </div>


    <script src="/js/cuenta.js"></script>
    <script src="/js/client.js"></script>
    <script src="/js/editUser.js"></script>

    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"
        integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"
        integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl"
        crossorigin="anonymous"></script>
</body>

</html>