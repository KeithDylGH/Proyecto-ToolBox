<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToolBox - Configuración</title>
  <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png">
  <link rel="stylesheet" href="/css/cuenta.css">
  <link rel="stylesheet" href="/css/configuration.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
  <div>
    <section>
      <div class="sidebar">
        <a href="#" id="homeBtn"><img src="/img/logo/Logo Letra trazo.png" alt="logo" class="logo"></a>
        <a href="#" id="client">Inicio</a>
        <a href="#configuracion" class="active">Configuración</a>
        <button class="Log-Out" id="logout"><a href="#">Cerrar sesión</a></button>
      </div>
    </section>

    <section class="interfaz">
      <div class="container">
        <div class="content">
          <h3>Configuración de Cuenta</h3>
          <form id="formActualizar">
            <div class="mb-3">
              <label for="nombre" class="form-label">Nombre</label>
              <input type="text" class="form-control" id="nombre" required>
            </div>
            <div class="mb-3">
              <label for="apellido" class="form-label">Apellido</label>
              <input type="text" class="form-control" id="apellido" required>
            </div>
            <div class="mb-3">
              <label for="correo" class="form-label">Correo</label>
              <input type="email" class="form-control" id="correo" required>
            </div>
            <div class="mb-3">
              <label for="password" class="form-label">Nueva Contraseña</label>
              <input type="password" class="form-control" id="password">
            </div>
            <button type="submit" class="btn btn-primary">Actualizar</button>
          </form>
        </div>
      </div>
    </section>
  </div>

  <script src="/js/editUser.js"></script>
</body>

</html>