<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro - ToolBox</title>

    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="stylesheet" href="/css/login.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;700&display=swap" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100 bg-white">

    <div class="container py-5 flex-grow-1">
        <div class="row justify-content-center align-items-center h-100">
            <div class="col-12 col-lg-9 col-xl-7">
                <a href="/" id="homeBtn"><img src="/img/logo/LogoLetra.png" alt="Logo" style="max-width: 50%;"></a>
                <div class="card shadow-2-strong card-registration" style="border-radius: 15px; background-color: #5e3b3b;"> <!-- Color del card igual al del login -->
                    <div class="card-body p-4 p-md-5 text-white">
                        <h2 class="fw-bold mb-4 text-uppercase">Crea una cuenta</h2>

                        <form id="formulario">
                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <div class="form-outline">
                                        <input type="text" id="name" class="form-control form-control-lg" placeholder="Su nombre" required>
                                        <label class="form-label" for="name">Tu nombre</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-4">
                                    <div class="form-outline">
                                        <input type="text" id="lName" class="form-control form-control-lg" placeholder="Su apellido" required>
                                        <label class="form-label" for="lName">Apellido</label>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <div class="form-outline">
                                        <input type="text" id="username" class="form-control form-control-lg" placeholder="Usuario" required>
                                        <label class="form-label" for="username">Tu nombre de usuario</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-4">
                                    <div class="form-outline">
                                        <input type="email" id="email" class="form-control form-control-lg" placeholder="Nombre@email.com" required>
                                        <label class="form-label" for="email">Tu correo</label>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <div class="form-outline">
                                        <input type="password" id="password" class="form-control form-control-lg" placeholder="Contraseña" required>
                                        <label class="form-label" for="password">Contraseña</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-4">
                                    <div class="form-outline">
                                        <input type="password" id="confirmPassword" class="form-control form-control-lg" placeholder="Repite tu contraseña" required>
                                        <label class="form-label" for="confirmPassword">Repite tu contraseña</label>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <div class="form-outline">
                                        <input type="tel" id="phoneNumber" class="form-control form-control-lg" placeholder="Tu número telefónico" required>
                                        <label class="form-label" for="phoneNumber">Tu número de Teléfono</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-4">
                                    <div class="form-outline">
                                        <input type="tel" id="cedula" class="form-control form-control-lg" placeholder="C.I" required>
                                        <label class="form-label" for="cedula">Cédula de Identificación</label>
                                    </div>
                                </div>
                            </div>

                            <div class="form-check d-flex justify-content-center mb-5">
                                <input class="form-check-input me-2" type="checkbox" value="" id="terms" required />
                                <label class="form-check-label" for="terms">
                                    Acepto todos los <a href="/terminos-y-condicion" class="text-body"><u>Términos de servicio</u></a>
                                </label>
                            </div>

                            <button class="btn btn-outline-light btn-lg px-5" type="submit">Registrar</button>

                            <p class="small mt-4">¿Ya tienes una cuenta? <a href="/login" class="text-light fw-bold"><u>Iniciar sesión</u></a></p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="mt-auto py-3 bg-dark text-light">
        <div class="container text-center">
            <a href="/acerca-de" class="text-light">Sobre nosotros</a>
            <p class="mb-0">© 2024 ToolBox. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="/js/notificacion.js"></script>
</body>
</html>