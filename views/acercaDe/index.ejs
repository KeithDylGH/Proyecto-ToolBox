<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acerca de - ToolBox</title>
    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png" />
    
    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- <link rel="stylesheet" href="/css/home.css"> -->
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/buscador.css">
    <link rel="stylesheet" href="/css/notificacion.css">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <script src="/js/notificacion.js"></script>
    <script src="//code.jquery.com/jquery-1.11.1.min.js"></script>
  </head>
  <body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container-fluid">
                <a href="/"><img src="/img/logo/Logo Letra trazo.png" alt="" class="w-25"></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll"
                    aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarScroll">
                    <ul class="navbar-nav me-auto my-2 my-lg-0 navbar-nav-scroll">
                        <li class="nav-item">
                            <a class="nav-link active link-light" aria-current="page" href="/">Inicio</a>
                        </li>
    
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle link-light" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Categoría
                            </a>
                            <ul class="dropdown-menu">
                                <% if (categorias && categorias.length > 0) { %>
                                    <% categorias.forEach(categoria => { %>
                                        <li><a class="dropdown-item" href="/tienda/<%= categoria._id %>"><%= categoria.nombre %></a></li>
                                    <% }) %>
                                <% } else { %>
                                    <li><a class="dropdown-item" href="#">No hay categorías disponibles</a></li>
                                <% } %>
                            </ul>
                        </li>
    
                        <li class="nav-item">
                            <a href="#" class="carrito" data-bs-toggle="modal" data-bs-target="#carritoModal">
                                <img src="/img/icono/carrito de compras.png" alt="carrito" />
                            </a>
    
                            <div class="modal fade" id="carritoModal" tabindex="-1" aria-labelledby="carritoModalLabel" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title text-black" id="carritoModalLabel">Tu Carrito de Compras</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <ul id="carritoList" class="list-group">
                                                <!-- Aquí se cargarán dinámicamente los productos del carrito -->
                                            </ul>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                            <a type="button" href="/cuenta/carrito" class="btn btn-primary">Más Detalles</a>
                                            <button type="button" id="vaciarCarrito" class="btn btn-warning">Vaciar Carrito</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
    
                        <% if (CUsuario) { %>
                            <li class="nav-item">
                                <a class="nav-link link-light" href="/cuenta">
                                    <%= CUsuario.nombre %>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link link-light" href="/logout">Cerrar sesión</a>
                            </li>
                        <% } else { %>
                            <li class="nav-item">
                                <a class="nav-link link-light" id="login" href="/login">Iniciar sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link link-light" id="register" href="/registrar">Registrarse</a>
                            </li>
                        <% } %>
    
                    </ul>
                    <form class="d-flex flex-column position-relative" id="productSearchForm">
                        <div class="d-flex">
                            <input class="form-control me-2" id="searchInput" type="search" placeholder="Busca aquí" aria-label="Search" autocomplete="off">
                        </div>
                        <div id="suggestions" class="list-group mt-2 position-absolute w-100"></div>
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-5">
        <div class="card mb-4">
            <div class="card-body">
                <h1>Sobre ToolBox</h1>
                <p>
                    En <strong>ToolBox</strong>, nos enorgullecemos de ser tu aliado confiable en 
                    la compra de productos de ferretería y artículos esenciales para el hogar. 
                    Nuestra amplia gama de productos está diseñada para satisfacer todas tus necesidades, 
                    ya sea que estés llevando a cabo un proyecto grande o simplemente buscando mejorar tu espacio en casa.
                </p>
                <p>
                    Nos comprometemos a proporcionar un entorno seguro para nuestras transacciones, 
                    garantizando la protección de tus datos personales y ofreciendo múltiples opciones de pago seguras. 
                </p>
            </div>
        </div>
    
        <div class="card mb-4">
            <div class="card-body">
                <h2>¿Qué productos vendemos?</h2>
                <ul class="list-unstyled">
                    <li><strong style="font-size: 1.1rem;">Muebles:</strong> Sillas, mesas, estanterías y más para decorar y organizar tu hogar.</li>
                    <li><strong style="font-size: 1.1rem;">Iluminación:</strong> Bombillos y sistemas de iluminación para crear el ambiente perfecto.</li>
                    <li><strong style="font-size: 1.1rem;">Equipo de seguridad:</strong> Cascos, guantes y otros artículos para protegerte mientras trabajas.</li>
                    <li><strong style="font-size: 1.1rem;">Herramientas:</strong> Una amplia gama de herramientas pesadas y básicas para cualquier proyecto, desde reparaciones hasta grandes construcciones.</li>
                </ul>
            </div>
        </div>
    
        <div class="card mb-4">
            <div class="card-body">
                <h2>Métodos de Pago Disponibles</h2>
                <p>Ofrecemos varias opciones para que realices tus compras de forma conveniente:</p>
        
                <div class="d-flex justify-content-center flex-wrap">
                    <!-- BDV Card -->
                    <div class="card" style="width: 14rem; border-radius: .5rem; margin: 10px;">
                        <div class="card-body">
                            <h5 class="card-subtitle mb-2 mt-2">
                                <img src="/img/icono/bdv.png" alt="Pago Móvil" width="50px">
                                Pago Móvil
                            </h5>
                            <p class="card-text">Realiza tus pagos fácilmente con BDV.</p>
                        </div>
                    </div>
        
                    <!-- Zinli Card -->
                    <div class="card" style="width: 14rem; border-radius: .5rem; margin: 10px;">
                        <div class="card-body">
                            <h5 class="card-subtitle mb-2 mt-2">
                                <img src="/img/icono/zinli.png" alt="Zinli" width="50px">
                                Zinli
                            </h5>
                            <p class="card-text">Usa Zinli para tus transacciones rápidas.</p>
                        </div>
                    </div>
        
                    <!-- Transferencia Card -->
                    <div class="card" style="width: 14rem; border-radius: .5rem; margin: 10px;">
                        <div class="card-body">
                            <h5 class="card-subtitle mb-2 mt-2">
                                <img src="/img/icono/transferencia-bancaria.png" alt="Transferencia" width="50px">
                                Transferencia
                            </h5>
                            <p class="card-text">Transfiere fondos con tarjeta de crédito.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>        
    
        <div class="card mb-4">
            <div class="card-body">
                <h2>Contactos</h2>
                <p>Para más información, no dudes en contactarnos y visitar nuestras redes:</p>
        
                <div class="d-flex flex-wrap justify-content-between">
                    <!-- WhatsApp Card -->
                    <div class="card mb-3" style="max-width: 540px; margin: 10px;">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src="/img/icono/whatsapp.png" class="img-fluid rounded-start" alt="WhatsApp">
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">WhatsApp</h5>
                                    <p class="card-text">Si tienes alguna falla o duda, no dudes en contactarnos.</p>
                                    <a href="https://wa.me/+4126378817" target="_blank" class="btn btn-success">Contáctanos</a>
                                </div>
                            </div>
                        </div>
                    </div>
        
                    <!-- Facebook Card -->
                    <div class="card mb-3" style="max-width: 540px; margin: 10px;">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src="/img/icono/facebook.png" class="img-fluid rounded-start" alt="Facebook">
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">Facebook</h5>
                                    <p class="card-text">Visita nuestra página en Facebook para más información.</p>
                                    <a href="https://www.facebook.com" target="_blank" class="btn btn-primary">Visítanos</a>
                                </div>
                            </div>
                        </div>
                    </div>
        
                    <!-- X Card -->
                    <div class="card mb-3" style="max-width: 540px; margin: 10px;">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src="/img/icono/x.png" class="img-fluid rounded-start" alt="X">
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">X</h5>
                                    <p class="card-text">Síguenos en X para actualizaciones rápidas.</p>
                                    <a href="https://www.x.jpg" target="_blank" class="btn btn-info">Síguenos</a>
                                </div>
                            </div>
                        </div>
                    </div>
        
                    <!-- Instagram Card -->
                    <div class="card mb-3" style="max-width: 540px; margin: 10px;">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src="/img/icono/instagram.png" class="img-fluid rounded-start" alt="Instagram">
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">Instagram</h5>
                                    <p class="card-text">Síguenos para ver nuestras últimas novedades.</p>
                                    <a href="https://www.instagram.com" target="_blank" class="btn btn-danger">Síguenos</a>
                                </div>
                            </div>
                        </div>
                    </div>                   
                </div>
            </div>
        </div>        

    </main>    

    <footer>
        <div class="container text-center py-3">
          <div class="d-flex justify-content-center">
            <% if (CUsuario) { %>
              <a href="/cuenta" class="text-light me-3">Tu cuenta</a>
              <a href="/logout" class="text-light me-3">Cerrar sesión</a>
            <% } else { %>
              <a href="/login" class="text-light me-3">Iniciar sesión</a>
              <a href="/registrar" class="text-light me-3">Registrarse</a>
            <% } %>
            <a href="/acerca-de" class="text-light">Sobre nosotros</a>
          </div>
          <div class="social-media mt-2">
            <a href="https://www.facebook.com" class="text-light me-3" target="_blank">Facebook
              <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-brand-facebook" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.5" stroke="#ffffff" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3" />
              </svg>
            </a>
            <a href="https://www.X.com" class="text-light me-3" target="_blank">X 
              <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-brand-x" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.5" stroke="#ffffff" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
                <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
              </svg>
            </a>
            <a href="https://www.instagram.com" class="text-light" target="_blank">Instagram
              <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-brand-instagram" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.5" stroke="#ffffff" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M4 4m0 4a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z" />
                <path d="M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                <path d="M16.5 7.5l0 .01" />
              </svg>
            </a>
          </div>
          <p>© 2024 ToolBox. Todos los derechos reservados.</p>
        </div>
      </footer>      
    
    <script src="/js/buscador.js"></script>
  </body>
</html>
