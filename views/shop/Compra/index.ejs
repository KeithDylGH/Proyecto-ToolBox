<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Compra - ToolBox</title>
    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/css/compraC.css">
    <meta name="usuario-correo" content="<%= usuarioCorreo %>">
</head>
<body>
  <header>
    <nav class="navbar navbar-expand-lg navbar-light bg-secondary">
      <div class="container-fluid">
        <a href="/" class="navbar-brand mx-auto">
          <img src="/img/logo/Logo Letra trazo.png" alt="Logo" class="w-25">
        </a>
      </div>
    </nav>
  </header>

  <main class="container mt-4">
    <h2>Confirmar Compra</h2>
    <% if (producto) { %>
      <div class="row">
          <div class="col-md-8">
              <div class="card mb-3">
                  <div class="card-body">
                      <h5 class="card-title">Producto a Comprar</h5>
                      <p class="card-text"><%= producto %></p>
                      <p class="card-text">Precio: $<%= precio %></p>
                      <p class="card-text">Cantidad: <%= cantidad %></p>
                      <p class="card-text" id="totalMonto">Total: $<%= (precio * cantidad).toFixed(2) %></p>
                      <button id="siguienteBtn" class="btn btn-primary">Siguiente</button>
                      <button id="cancelarBtn" class="btn btn-secondary">Cancelar</button>
                  </div>
              </div>
          </div>
      </div>
      <div id="metodosPago" class="d-none">
          <h3>Selecciona un Método de Pago</h3>
          <button id="pagoMovilBtn" class="btn btn-info">Pago Móvil</button>
          <button id="transferenciaBtn" class="btn btn-info">Transferencia</button>
          <button id="zinliBtn" class="btn btn-info">Zinli</button>
      </div>
      <div id="pagoMovilModal" class="modal fade" tabindex="-1" aria-labelledby="pagoMovilLabel" aria-hidden="true">
          <div class="modal-dialog">
              <div class="modal-content">
                  <div class="modal-header">
                      <h5 class="modal-title" id="pagoMovilLabel">Pago Móvil</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                      <form id="pagoMovilForm">
                          <!-- Contenido del formulario de Pago Móvil -->
                          <button type="submit" class="btn btn-primary">Confirmar Pago</button>
                          <button type="button" id="cancelarPagoBtn" class="btn btn-secondary">Cancelar</button>
                      </form>
                  </div>
              </div>
          </div>
      </div>
      <div id="transferenciaModal" class="modal fade" tabindex="-1" aria-labelledby="transferenciaLabel" aria-hidden="true">
          <div class="modal-dialog">
              <div class="modal-content">
                  <div class="modal-header">
                      <h5 class="modal-title" id="transferenciaLabel">Transferencia</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                      <form id="transferenciaForm">
                          <!-- Contenido del formulario de Transferencia -->
                          <button type="submit" class="btn btn-primary">Confirmar Pago</button>
                          <button type="button" id="cancelarPagoBtn" class="btn btn-secondary">Cancelar</button>
                      </form>
                  </div>
              </div>
          </div>
      </div>
      <div id="zinliModal" class="modal fade" tabindex="-1" aria-labelledby="zinliLabel" aria-hidden="true">
          <div class="modal-dialog">
              <div class="modal-content">
                  <div class="modal-header">
                      <h5 class="modal-title" id="zinliLabel">Zinli</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                      <form id="zinliForm">
                          <!-- Contenido del formulario de Zinli -->
                          <button type="submit" class="btn btn-primary">Confirmar Pago</button>
                          <button type="button" id="cancelarPagoBtn" class="btn btn-secondary">Cancelar</button>
                      </form>
                  </div>
              </div>
          </div>
      </div>
    <% } %>
  </main>

  <script src="/js/compra.js"></script>
</body>
</html>