<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Compra Carrito - ToolBox</title>
    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/css/compraC.css">
    <link rel="stylesheet" href="/css/loader.css">
    <link rel="stylesheet" href="/css/notification.css">
    <meta name="usuario-correo" content="<%= usuarioCorreo %>">

    <!-- Initialize the JS-SDK -->
    <script src="https://sandbox.paypal.com/sdk/js?client-id=AekIqsAkZLP2E7x9w90Mmz19XB1XSyAGeSwJeHimjrmIGbdKbQPu-PsFgY9qMQdqltYUMF_dDDkqxqJ-&currency=USD&components=buttons"></script>
</head>

<!-- Loader -->
<div id="loader" class="d-none loader-overlay">
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Cargando...</span>
    </div>
</div>  

<!-- Notificación -->
<div id="notification" class="notification d-none"></div>

<body>
  <header>
    <nav class="navbar navbar-expand-lg navbar-light bg-secondary">
      <div class="container-fluid">
        <a href="/" class="navbar-brand mx-auto">
          <img src="/img/logo/Logo Letra trazo.png" alt="Logo" class="w-25">
        </a>
      </div>
    </nav>
  </header>

  <main class="container mt-4">
    <h2>Confirmar Compra</h2>
    <% if (productos && productos.length > 0) { %>
      <div class="row">
          <div class="col-md-8">
              <div class="card mb-3">
                  <div class="card-body">
                      <h5 class="card-title">Productos en el Carrito</h5>
                      <ul class="list-group">
                          <% productos.forEach(producto => { %>
                                <li class="list-group-item d-flex producto" data-id="<%= producto._id %>">
                                  <img src="<%= producto.imagen.data %>" alt="<%= producto.nombre %>" class="img-thumbnail me-3" style="width: 25%;">
                                  <div>
                                      <h6><%= producto.nombre %></h6>
                                      <p>Precio Unitario: $<%= producto.precio.toFixed(2) %></p>
                                      <p>Cantidad: <%= producto.cantidad || 1 %></p>
                                      <p>Total: $<%= (isNaN(parseFloat(producto.precio)) || isNaN(parseInt(producto.cantidad)) ? 0 : (parseFloat(producto.precio) * parseInt(producto.cantidad))).toFixed(2) %></p>
                                  </div>
                              </li>
                          <% }); %>
                      </ul>
                      <h4>Total: <span id="totalMonto">$<%= totalCarrito.toFixed(2) %></span></h4>
                  </div>

              </div>
          </div>
          <div class="col-md-4">
              <div class="card">
                  <div class="card-body text-center">
                      <a class="btn btn-primary btn-lg btn-block" href="#" id="siguienteBtn">Siguiente</a>
                      <a class="btn btn-secondary btn-lg btn-block mt-2" href="/" id="cancelarBtn">Cancelar</a>
                      <div id="metodosPago" class="d-none mt-3">
                        <h3>Selecciona el Método de Pago</h3>
                        <button id="pagoMovilBtn" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#pagoMovilModal">Pago Móvil</button>
                        <button id="transferenciaBtn" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#transferenciaModal">Transferencia</button>
                        <button id="zinliBtn" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#zinliModal">Zinli</button>
                        <button id="paypalBtn" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#paypalModal">PayPal</button>
                        <a class="btn btn-secondary btn-lg mt-2" href="/" id="cancelarPagoBtn">Cancelar</a>
                      </div>
                    </div>
                  </div>
              </div>
          </div>
    
          <!-- Modal Pago Móvil -->
          <div class="modal fade" id="pagoMovilModal" tabindex="-1" aria-labelledby="pagoMovilLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="pagoMovilLabel">Pago Móvil</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="pagoMovilForm">
                            <input type="hidden" name="metodoPago" value="Pago Móvil">
                            <p>Por favor complete la información para continuar con el pago móvil.</p>
                            <ul>
                                <li>Selecciona la opción "Pago Móvil".</li>
                                <li>Ingresa los siguientes datos:</li>
                                <ul>
                                    <li>Teléfono de la Empresa: <strong>+0412-6378817</strong></li>
                                    <li>Cédula de la Empresa: <strong>V-30815482</strong></li>
                                </ul>
                                <li>Introduce el monto total de la compra y confirma el pago.</li>
                            </ul>
                            <p>Una vez realizado el pago, envía una captura del comprobante a través de <a href="https://wa.me/+4126378817" target="_blank" class="btn btn-success">WhatsApp</a>.</p>
                            <button type="submit" class="btn btn-primary" id="confirmarPagoMovilBtn">Confirmar Pago</button>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
          </div>
    
          <!-- Modal Transferencia -->
          <div class="modal fade" id="transferenciaModal" tabindex="-1" aria-labelledby="transferenciaLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="transferenciaLabel">Transferencia</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="transferenciaForm">
                            <input type="hidden" name="metodoPago" value="Transferencia">
                            <p>Por favor complete la información para continuar con la transferencia.</p>
                            <ul>
                                <li>Realiza una transferencia a la cuenta a nombre de <strong>ToolBox</strong>.</li>
                                <li>Ingresa los siguientes datos:</li>
                                <ul>
                                    <li>Banco: <strong>Banco Mercantil</strong></li>
                                    <li>Cuenta: <strong>0132-0009-69-3310692181</strong></li>
                                </ul>
                                <li>Introduce el monto total de la compra y confirma la transferencia.</li>
                            </ul>
                            <p>Una vez realizada la transferencia, envía una captura del comprobante a través de <a href="https://wa.me/+4126378817" target="_blank" class="btn btn-success">WhatsApp</a>.</p>
                            <button type="submit" class="btn btn-primary" id="confirmarTransferenciaBtn">Confirmar Transferencia</button>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
          </div>
    
          <!-- Modal Zinli -->
          <div class="modal fade" id="zinliModal" tabindex="-1" aria-labelledby="zinliLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="zinliLabel">Zinli</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="zinliForm">
                            <input type="hidden" name="metodoPago" value="Zinli">
                            <p>Por favor completa la información para continuar con el pago por Zinli.</p>
                            <p>Ingresa el monto total y confirma el pago.</p>
                            <button type="submit" class="btn btn-primary" id="confirmarZinliBtn">Confirmar Pago</button>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
          </div>
    
          <!-- Modal PayPal -->
        <div class="modal fade" id="paypalModal" tabindex="-1" aria-labelledby="paypalModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="paypalModalLabel">Pagar con PayPal</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="paypal-button-container"></div>
                    </div>
                </div>
            </div>
        </div>
        
      </div>
    <% } else { %>
      <p>No hay productos en el carrito.</p>
    <% } %>
  </main>

  <script src="/js/compra.js"></script>
</body>
</html>
