<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Compra - Carrito - ToolBox</title>
    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png" />
    <link rel="stylesheet" href="/css/compra.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
  <header>
    <nav class="navbar navbar-expand-lg navbar-light bg-secondary">
      <div class="container-fluid">
        <a href="/" class="navbar-brand mx-auto">
          <img src="/img/logo/Logo Letra trazo.png" alt="Logo" class="w-25">
        </a>
      </div>
    </nav>
  </header>

  <main class="container mt-4">
    <h2>Confirmar Compra</h2>
    <% if (productos.length > 0) { %>
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title">Productos en tu Carrito</h5>
          <% productos.forEach(producto => { %>
            <div class="producto-item d-flex mb-3">
              <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>" class="img-thumbnail" style="max-width: 100px; margin-right: 20px;">
              <div>
                <h6><%= producto.nombre %></h6>
                <p>Precio Unitario: $<%= producto.precio.toFixed(2) %></p>
                <p>Cantidad: <%= producto.cantidad %></p>
                <p>Total: $<%= (producto.precio * producto.cantidad).toFixed(2) %></p>
              </div>
            </div>
          <% }) %>
          <h4>Total Carrito: $<%= totalCarrito.toFixed(2) %></h4>

          <!-- Botón Siguiente y Cancelar -->
          <a class="btn btn-primary" href="#" id="siguienteBtn">Siguiente</a>
          <a class="btn btn-secondary" href="/" id="cancelarBtn">Cancelar</a>
        </div>
      </div>

      <!-- Sección de Métodos de Pago -->
      <div id="metodosPago" class="d-none">
        <div class="card">
          <div class="card-body text-center">
            <h3>Selecciona el Método de Pago</h3>
            <button class="btn btn-success" id="pagoMovilBtn">Pago Móvil</button>
            <button class="btn btn-primary" id="paypalBtn">PayPal</button>
            <a class="btn btn-secondary mt-2" href="/" id="cancelarPagoBtn">Cancelar</a>
          </div>
        </div>
      </div>

      <!-- Modal for Pago Móvil -->
      <div id="pagoMovilModal" class="modal fade" tabindex="-1" aria-labelledby="pagoMovilModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="pagoMovilModalLabel">Instrucciones para Pago Móvil</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="row">
                <div class="col-md-4">
                  <h4>1. Ingresa</h4>
                  <p>Accede a la página de <a href="https://www.bancodevenezuela.com" target="_blank">BDV</a>.</p>
                </div>
                <div class="col-md-4">
                  <h4>2. Datos</h4>
                  <ul>
                    <li>Teléfono: <strong>+0412-6378817</strong></li>
                    <li>Cédula: <strong>V-30815482</strong></li>
                  </ul>
                </div>
                <div class="col-md-4">
                  <h4>3. Pago</h4>
                  <p>Realiza el pago y envía el comprobante vía <a href="https://wa.me/+4126378817" target="_blank" class="btn btn-success">WhatsApp</a>.</p>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
          </div>
        </div>
      </div>
    <% } else { %>
      <p>No hay productos en el carrito.</p>
    <% } %>
  </main>

  <script src="/js/compra.js"></script>
</body>
</html>