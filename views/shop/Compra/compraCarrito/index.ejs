<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Compra - Carrito - ToolBox</title>
    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/css/compraC.css">
</head>
<body>
  <header>
    <nav class="navbar navbar-expand-lg navbar-light bg-secondary">
      <div class="container-fluid">
        <a href="/" class="navbar-brand mx-auto">
          <img src="/img/logo/Logo Letra trazo.png" alt="Logo" class="w-25">
        </a>
      </div>
    </nav>
  </header>

  <main class="container mt-4">
    <h2>Confirmar Compra</h2>
    <% if (productos.length > 0) { %>
      <div class="row">
        <div class="col-md-8">
          <div class="card mb-3">
            <div class="card-body">
              <h5 class="card-title">Productos en tu Carrito</h5>
              <ul id="carritoList" class="list-group">
                <% productos.forEach(producto => { %>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <img src="<%= producto.imagen.data %>" alt="<%= producto.nombre %>" class="img-thumbnail" style="max-width: 100px; margin-right: 20px;">
                    <div>
                      <h6><%= producto.nombre %></h6>
                      <p>Precio Unitario: $<%= producto.precio.toFixed(2) %></p>
                      <p>Cantidad: <%= producto.cantidad %></p>
                      <p>Total: $<%= (producto.precio * producto.cantidad).toFixed(2) %></p>
                    </div>
                  </li>
                <% }) %>
              </ul>
              <h4 id="totalMonto" class="mt-3">Total Carrito: $<%= totalCarrito.toFixed(2) %></h4>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="d-flex justify-content-end">
            <div class="btn-group" role="group">
              <a class="btn btn-primary" href="#" id="siguienteBtn">Siguiente</a>
              <a class="btn btn-secondary" href="/" id="cancelarBtn">Cancelar</a>
            </div>
          </div>
        </div>
      </div>

      <!--Modal for Pago Movil-->
      <div id="metodosPago" class="d-none mt-4">
        <div class="card position-relative">
          <div class="card-body">
            <h3>Selecciona el Método de Pago</h3>
            <div class="position-absolute top-0 end-0 p-3">
              <button class="btn btn-success d-block mb-2" id="pagoMovilBtn">Pago Móvil</button>
              <button class="btn btn-primary d-block mb-2" id="transferenciaBtn">Transferencia</button>
              <button class="btn btn-info d-block mb-2" id="zinliBtn">Zinli</button>
              <a class="btn btn-secondary" href="/" id="cancelarPagoBtn">Cancelar</a>
            </div>
          </div>
        </div>
    </div>

    <!-- Modal for Transferencia -->
    <div id="transferenciaModal" class="modal fade" tabindex="-1" aria-labelledby="transferenciaModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="transferenciaModalLabel">Instrucciones para Transferencia</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <h4>Paso 1: Realiza la Transferencia</h4>
            <p>Datos de la cuenta bancaria:</p>
            <ul>
              <li>Banco: <strong>Banesco</strong></li>
              <li>Número de cuenta: <strong>0134-5678-9123-4567</strong></li>
              <li>Nombre del titular: <strong>ToolBox S.A.</strong></li>
              <li>RIF: <strong>J-12345678-9</strong></li>
            </ul>
            <h4>Paso 2: Confirmar Transferencia</h4>
            <p>Envía el comprobante vía <a href="https://wa.me/+4126378817" target="_blank" class="btn btn-success">WhatsApp</a>.</p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Modal for Zinli -->
    <div id="zinliModal" class="modal fade" tabindex="-1" aria-labelledby="zinliModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="zinliModalLabel">Instrucciones para Zinli</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <h4>Paso 1: Realiza el Pago en Zinli</h4>
            <p>Datos para el pago:</p>
            <ul>
              <li>Número de cuenta Zinli: <strong>0412-6378817</strong></li>
              <li>Nombre del titular: <strong>ToolBox S.A.</strong></li>
            </ul>
            <h4>Paso 2: Confirmar Pago</h4>
            <p>Envía el comprobante vía <a href="https://wa.me/+4126378817" target="_blank" class="btn btn-success">WhatsApp</a>.</p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
          </div>
        </div>
      </div>
    </div>    
    <% } else { %>
      <p>No hay productos en el carrito.</p>
    <% } %>
  </main>

  <script src="/js/compra.js"></script>
</body>
</html>