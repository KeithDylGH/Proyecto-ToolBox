<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catalogo - ToolBox</title>
    <link rel="stylesheet" href="/css/catalogo.css">
    <link rel="icon" type="image/x-icon" href="/img/logo/logo Saturn.png">
    
    <!--BOOTSTRAP-->
   <!--  <link rel="stylesheet" href="/bootstrap-5.3.3-dist/css/bootstrap.rtl.min.css">
    <script src="/bootstrap-5.3.3-dist/js/bootstrap.bundle.js"></script> -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
</head>
<body>
  <header>
    <nav class="navbar navbar-expand-lg navbar-light">
        <div class="container-fluid">
            <a href="#"><img src="/img/logo/Logo Letra trazo.png" alt="" class="w-25"></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll"
                aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarScroll">
                <ul class="navbar-nav me-auto my-2 my-lg-0 navbar-nav-scroll">
                    <li class="nav-item">
                        <a class="nav-link active link-light" aria-current="page" href="#">Inicio</a>
                    </li>
                    <li class="nav-item dropdown">
                      <a class="nav-link dropdown-toggle link-light" href="#" role="button"
                          data-bs-toggle="dropdown" aria-expanded="false">
                          Categoría
                      </a>
                      <ul class="dropdown-menu">
                          <% categorias.forEach(categoria => { %>
                              <li><a class="dropdown-item" href="/tienda/<%= categoria._id %>"><%= categoria.nombre %></a></li>
                          <% }) %>
                      </ul>
                  </li>

                    <li class="nav-item">
                      <a href="#" class="carrito" data-bs-toggle="modal" data-bs-target="#carritoModal">
                        <img src="/img/icono/carrito de compras.png" alt="carrito" />
                      </a>
      
                      <div class="modal fade" id="carritoModal" tabindex="-1" aria-labelledby="carritoModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                          <div class="modal-content">
                            <div class="modal-header">
                              <h5 class="modal-title text-black" id="carritoModalLabel">Tu Carrito de Compras</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                              <ul id="carritoList" class="list-group">
                                <!-- Aquí se cargarán dinámicamente los productos del carrito -->
                              </ul>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                              <a type="button" href="/cuenta/carrito" class="btn btn-primary">Más Detalles</a>
                              <button type="button" id="vaciarCarrito" class="btn btn-warning">Vaciar Carrito</button>
                            </div>
                          </div>
                        </div>
                      </div>
                    </li>                                                            

                    <% if (CUsuario) { %>
                      <li class="nav-item">
                          <% if (CUsuario.rol === 'admin') { %>
                              <a class="nav-link link-light" href="/admin">
                                  <%= CUsuario.nombre %>
                              </a>
                          <% } else { %>
                              <a class="nav-link link-light" href="/cliente">
                                  <%= CUsuario.nombre %>
                              </a>
                          <% } %>
                      </li>
                      <li class="nav-item">
                          <a class="nav-link link-light" href="/logout">Cerrar sesión</a>
                      </li>
                  <% } else { %>
                      <li class="nav-item">
                          <a class="nav-link link-light" id="login" href="/login">Iniciar sesión</a>
                      </li>
                      <li class="nav-item">
                          <a class="nav-link link-light" id="register" href="/registrar">Registrarse</a>
                      </li>
                  <% } %>                    
                                                                                                    
                </ul>
                <!-- <form class="d-flex" role="search">
                    <input class="form-control me-2" type="search" placeholder="Busca aquí" aria-label="Search">
                    <button class="btn btn-outline-success" type="submit">Buscar</button>
                </form> -->
            </div>
        </div>
    </nav>
</header>


<div class="mainContainer">
  <div class="container-fluid">
    <section class="product-listing">
        <div class="contenedor">
            <div class="row pb-5 mb-4">
                <% productos.forEach(function(producto) { %>
                <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                    <!-- Card -->
                    <div class="card rounded shadow-sm border-0">
                        <div class="card-body p-4">
                            <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>" class="img-fluid d-block mx-auto mb-3">
                            <h5><a href="#" class="text-dark"><%= producto.nombre %></a></h5>
                            <p class="small">Precio: <%= producto.precio %> $</p>
                            <button class="button-1" role="button">Ver más</button>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </section>
  </div>  
</div>

 
<footer class="bg-body-tertiary text-center text-lg-start">
    <!-- Grid container -->
    <div class="container p-4">
      <!--Grid row-->
      <div class="row">
  
        <!--Grid column-->
        <div class="col-lg-3 col-md-6 mb-4 mb-md-0">
          <h5 class="text-uppercase">Acerca de</h5>
  
          <ul class="mb-0">
            <li>
              <a href="#!" class="text-body">Nosotros</a>
            </li>
            <li>
              <a href="#!" class="text-body">Servicios</a>
            </li>
            <li>
              <a href="#!" class="text-body">Productos</a>
            </li>
            <li>
              <a href="#!" class="text-body">Inventarios</a>
            </li>
          </ul>
        </div>
        <!--Grid column-->
  
        <div class="col-lg-3 col-md-6 mb-4 mb-md-0">
          <h5 class="text-uppercase">Pagos</h5>
  
          <ul class="mb-0">
            <li>
              <a href="#!" class="text-body">Metodos de Pago</a>
            </li>
            <li>
              <a href="#!" class="text-body">Cuenta</a>
            </li>
            <li>
              <a href="#!" class="text-body">Crear cuenta</a>
            </li>
          </ul>
        </div>

        <!--Grid column-->
        <div class="col-lg-3 col-md-6 mb-4 mb-md-0">
          <h5 class="text-uppercase mb-0">Contactos</h5>
  
          <ul>
            <li>
              <a href="https://www.whatsapp.com/?lang=es_LA" class="text-body">WhatsApp
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-brand-whatsapp" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.5" stroke="#00b341" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
                    <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
                  </svg>
              </a>
            </li>
            <li>
              <a href="https://www.google.com/intl/es-419/gmail/about/" class="text-body">Gmail
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-brand-gmail" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.5" stroke="#ff4500" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M16 20h3a1 1 0 0 0 1 -1v-14a1 1 0 0 0 -1 -1h-3v16z" />
                    <path d="M5 20h3v-16h-3a1 1 0 0 0 -1 1v14a1 1 0 0 0 1 1z" />
                    <path d="M16 4l-4 4l-4 -4" />
                    <path d="M4 6.5l8 7.5l8 -7.5" />
                  </svg>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  
    <!-- Copyright -->
    <div class="text-center p-3" style="background-color: rgba(0, 0, 0, 0.05);">
      © 2024 Copyright:
      <a class="text-body" href="#">ToolBox</a>
    </div>
    <!-- Copyright -->
  </footer>
</body>
</html>
