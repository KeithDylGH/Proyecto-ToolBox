<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= producto.nombre %> - ToolBox</title>

    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png" />
    <link rel="stylesheet" href="/css/producto.css" />
    
    <!--BOOTSTRAP-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
</head>
<body>
  <%- include('partials/header') %> <!-- Incluir el header -->
  </header>

  <main>
    <div class="container mt-4">
      <div class="row">
        <div class="col-md-4">
          <img src="<%= producto.imagen.data %>" alt="<%= producto.nombre %>" class="img-fluid">
        </div>
        <div class="col-md-8">
          <h3><%= producto.nombre %></h3>
          <p><b>Marca:</b> <%= producto.marca %></p>
          <p><b>Material:</b> <%= producto.material %></p>
          <hr>
          <h4>Precio: $<%= producto.precio.toFixed(2) %></h4>
          <button class="btn btn-danger btn-lg btn-block mt-2" id="agregarCarritoBtn" data-producto-id="<%= producto._id %>">Añadir al carrito</button>
          <button class="btn btn-success btn-lg btn-block mt-2" id="comprarBtn" data-producto-id="<%= producto._id %>">Comprar</button>
          
          <% if (!producto.disponible) { %>
            <p class="mt-3"><strong>No disponible.</strong></p>
            <p>Este producto no está disponible en stock actualmente.</p>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <footer class="mt-5 px-4 pt-3 pb-1">
    <div class="row">
      <div class="col-5 col-md-2 mb-3">
        <h5>Acerca de</h5>
        <ul class="list-unstyled mb-0">
          <li class="text-light">
            <a href="#!">Nosotros</a>
          </li>
          <li>
            <a href="#!">Servicios</a>
          </li>
          <li>
            <a href="#!">Productos</a>
          </li>
          <li>
            <a href="#!">Inventarios</a>
          </li>
        </ul>
      </div>

      <div class="col-5 col-md-2 mb-3">
        <h5>Pagos</h5>
        <ul class="list-unstyled mb-0">
          <li>
            <a href="#!">Metodos de Pago</a>
          </li>
          <li>
            <a href="#!">Cuenta</a>
          </li>
          <li>
            <a href="#!">Crear cuenta</a>
          </li>
        </ul>
      </div>

      <div class="col-5 col-md-2 mb-3">
        <h5>Contactos</h5>
        <ul class="list-unstyled">
          <li>
            <a href="https://www.whatsapp.com/?lang=es" class="link-light">WhatsApp</a>
          </li>
          <li>
            <a href="#!" class="link-light">Llamada</a>
          </li>
          <li>
            <a href="#!" class="link-light">Email</a>
          </li>
        </ul>
      </div>
    </div>

    <hr class="my-3" />
    <p class="text-center text-light mb-0">© 2024 ToolBox, Inc. All rights reserved.</p>
  </footer>

  <script src="/js/productoP.js"></script>
  <script src="/js/home.js"></script>
</body>
</html>