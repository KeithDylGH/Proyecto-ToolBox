<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= producto.nombre %> - ToolBox</title>

    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png" />
    <link rel="stylesheet" href="/css/buscador.css">
    <link rel="stylesheet" href="/css/producto.css" />
    <link rel="stylesheet" href="/css/notificacion.css">
    
    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />

    <!--Query para el Carrusel-->
    <script src="//code.jquery.com/jquery-1.11.1.min.js"></script>
</head>
<body>
  
  <!--NOTIFICACION-->
  <div class="notification d-none"></div>

  <header>
    <nav class="navbar navbar-expand-lg navbar-light">
        <div class="container-fluid">
            <a href="/"><img src="/img/logo/Logo Letra trazo.png" alt="" class="w-25"></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll"
                aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarScroll">
                <ul class="navbar-nav me-auto my-2 my-lg-0 navbar-nav-scroll">
                    <li class="nav-item">
                        <a class="nav-link active link-light" aria-current="page" href="#">Inicio</a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle link-light" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            Categoría
                        </a>
                        <ul class="dropdown-menu">
                            <% if (categorias && categorias.length > 0) { %>
                                <% categorias.forEach(categoria => { %>
                                    <li><a class="dropdown-item" href="/tienda/<%= categoria._id %>"><%= categoria.nombre %></a></li>
                                <% }) %>
                            <% } else { %>
                                <li><a class="dropdown-item" href="#">No hay categorías disponibles</a></li>
                            <% } %>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a href="#" class="carrito" data-bs-toggle="modal" data-bs-target="#carritoModal">
                            <img src="/img/icono/carrito de compras.png" alt="carrito" />
                        </a>

                        <div class="modal fade" id="carritoModal" tabindex="-1" aria-labelledby="carritoModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title text-black" id="carritoModalLabel">Tu Carrito de Compras</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <ul id="carritoList" class="list-group">
                                            <!-- Aquí se cargarán dinámicamente los productos del carrito -->
                                        </ul>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                        <a type="button" href="/cuenta/carrito" class="btn btn-primary">Más Detalles</a>
                                        <button type="button" id="vaciarCarrito" class="btn btn-warning">Vaciar Carrito</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>

                    <% if (CUsuario) { %>
                        <li class="nav-item">
                            <a class="nav-link link-light" href="/cuenta">
                                <%= CUsuario.nombre %>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link link-light" href="/logout">Cerrar sesión</a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link link-light" id="login" href="/login">Iniciar sesión</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link link-light" id="register" href="/registrar">Registrarse</a>
                        </li>
                    <% } %>

                </ul>
                <form class="d-flex flex-column position-relative" id="productSearchForm">
                    <div class="d-flex">
                        <input class="form-control me-2" id="searchInput" type="search" placeholder="Busca aquí" aria-label="Search" autocomplete="off">
                    </div>
                    <div id="suggestions" class="list-group mt-2 position-absolute w-100"></div>
                </form>
            </div>
        </div>
    </nav>
</header>

<main class="container mt-4">
  <div class="row mb-4">
    <div class="col-md-4">
      <img src="<%= producto.imagen.data %>" alt="<%= producto.nombre %>" class="img-fluid">
    </div>
    <div class="col-md-8">
      <h3><%= producto.nombre %></h3>
      <p><%= producto.descripcion %></p>
      <hr>
      <h4>Precio: $<%= producto.precio.toFixed(2) %></h4>
      <button class="btn btn-danger btn-lg btn-block mt-2 btn-agregar-carrito" data-producto-id="<%= producto._id %>">
        Agregar al Carrito
      </button>      
      <a href="#" class="btn btn-success btn-lg btn-block mt-2" id="comprarBtn" data-producto-id="<%= producto._id %>">Comprar</a>    
    </div>
  </div>

  <!-- Sección de productos aleatorios -->
  <section class="mb-5">
    
    <div id="carouselExampleControlsNoTouching" class="carousel slide" data-bs-touch="false" data-bs-interval="false">
        <div class="carousel-inner">
          <% for (let i = 0; i < productosDestacados.length; i += 4) { %> <!-- Agrupamos cada 4 productos en un slide -->
            <div class="carousel-item <%= i === 0 ? 'active' : '' %>"> <!-- Marcamos el primer slide como activo -->
              <div class="row">
                <% productosDestacados.slice(i, i + 4).forEach(producto => { %> <!-- Obtenemos un conjunto de 4 productos -->
                  <div class="col-md-3 mb-4">
                    <div class="card">
                      <img src="<%= producto.imagen.data %>" class="card-img-top" alt="<%= producto.nombre %>" />
                      <div class="card-body">
                        <h5 class="card-title"><%= producto.nombre %></h5>
                        <p class="card-text">$<%= producto.precio.toFixed(2) %></p>
                        <a href="/tienda/producto/<%= producto._id %>" class="card-title text-white p-2" style="border-radius: 5px; text-decoration: none;">Ver más</a>
                        <button class="btn btn-primary btn-agregar-carrito" data-producto-id="<%= producto._id %>">
                          Agregar al Carrito
                        </button>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControlsNoTouching" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControlsNoTouching" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
      
  </section>
  
  <footer class="mt-auto py-3 bg-dark text-light">
    <div class="container text-center">
      <div class="d-flex justify-content-center">
        <% if (CUsuario) { %>
          <a href="/cuenta" class="text-light me-3">Tu cuenta</a>
          <a href="/logout" class="text-light me-3">Cerrar sesión</a>
        <% } else { %>
          <a href="/login" class="text-light me-3">Iniciar sesión</a>
          <a href="/registrar" class="text-light me-3">Registrarse</a>
        <% } %>
        <a href="/acerca-de" class="text-light">Sobre nosotros</a>
      </div>
      <div class="social-media mt-2">
        <a href="https://www.facebook.com" class="text-light me-2">Facebook</a>
        <a href="https://www.instagram.com" class="text-light me-2">Instagram</a>
      </div>
      <p class="mt-2">&copy; 2024 ToolBox. Todos los derechos reservados.</p>
    </div>
  </footer>  

<script src="/js/productoP.js"></script>
<script src="/js/carrusel.js"></script>
<script src="/js/notificacion.js"></script>
<script src="/js/carritoC.js"></script>
<script src="/js/buscador.js"></script>
</body>
</html>