<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ToolBox - Inicio</title>
    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png" />
    
    <!--BOOTSTRAP-->
   <!--  <link rel="stylesheet" href="/bootstrap-5.3.3-dist/css/bootstrap.rtl.min.css">
    <script src="/bootstrap-5.3.3-dist/js/bootstrap.bundle.js"></script> -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    

    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/notificacion.css">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />

    <script src="/js/notificacion.js"></script>
    <!--Query para el Carrusel-->
    <script src="//code.jquery.com/jquery-1.11.1.min.js"></script>
  </head>
  <body>
    <header>
      <nav class="navbar navbar-expand-lg navbar-light">
          <div class="container-fluid">
              <a href="/"><img src="/img/logo/Logo Letra trazo.png" alt="" class="w-25"></a>
              <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll"
                  aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
                  <span class="navbar-toggler-icon"></span>
              </button>
              <div class="collapse navbar-collapse" id="navbarScroll">
                  <ul class="navbar-nav me-auto my-2 my-lg-0 navbar-nav-scroll">
                      <li class="nav-item">
                          <a class="nav-link active link-light" aria-current="page" href="#">Inicio</a>
                      </li>
  
                      <li class="nav-item dropdown">
                          <a class="nav-link dropdown-toggle link-light" href="#" role="button"
                             data-bs-toggle="dropdown" aria-expanded="false">
                              Categoría
                          </a>
                          <ul class="dropdown-menu">
                              <% if (categorias && categorias.length > 0) { %>
                                  <% categorias.forEach(categoria => { %>
                                      <li><a class="dropdown-item" href="/tienda/<%= categoria._id %>"><%= categoria.nombre %></a></li>
                                  <% }) %>
                              <% } else { %>
                                  <li><a class="dropdown-item" href="#">No hay categorías disponibles</a></li>
                              <% } %>
                          </ul>
                      </li>
  
                      <li class="nav-item">
                          <a href="#" class="carrito" data-bs-toggle="modal" data-bs-target="#carritoModal">
                              <img src="/img/icono/carrito de compras.png" alt="carrito" />
                          </a>
  
                          <div class="modal fade" id="carritoModal" tabindex="-1" aria-labelledby="carritoModalLabel" aria-hidden="true">
                              <div class="modal-dialog">
                                  <div class="modal-content">
                                      <div class="modal-header">
                                          <h5 class="modal-title text-black" id="carritoModalLabel">Tu Carrito de Compras</h5>
                                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                      </div>
                                      <div class="modal-body">
                                          <ul id="carritoList" class="list-group">
                                              <!-- Aquí se cargarán dinámicamente los productos del carrito -->
                                          </ul>
                                      </div>
                                      <div class="modal-footer">
                                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                          <a type="button" href="/cuenta/carrito" class="btn btn-primary">Más Detalles</a>
                                          <button type="button" id="vaciarCarrito" class="btn btn-warning">Vaciar Carrito</button>
                                      </div>
                                  </div>
                              </div>
                          </div>
                      </li>
  
                      <% if (CUsuario) { %>
                          <li class="nav-item">
                              <a class="nav-link link-light" href="/cuenta">
                                  <%= CUsuario.nombre %>
                              </a>
                          </li>
                          <li class="nav-item">
                              <a class="nav-link link-light" href="/logout">Cerrar sesión</a>
                          </li>
                      <% } else { %>
                          <li class="nav-item">
                              <a class="nav-link link-light" id="login" href="/login">Iniciar sesión</a>
                          </li>
                          <li class="nav-item">
                              <a class="nav-link link-light" id="register" href="/registrar">Registrarse</a>
                          </li>
                      <% } %>
  
                  </ul>
                  <form class="d-flex flex-column position-relative" id="productSearchForm">
                      <div class="d-flex">
                          <input class="form-control me-2" id="searchInput" type="search" placeholder="Busca aquí" aria-label="Search" autocomplete="off">
                      </div>
                      <div id="suggestions" class="list-group mt-2 position-absolute w-100"></div>
                  </form>
              </div>
          </div>
      </nav>
  </header>         

  <!--NOTIFICACION-->
  <div class="notification d-none"></div>

    <div class="container">
      <section class="hero">
        
        <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
          <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
          </div>
          <div class="carousel-inner">
            <div class="carousel-item active" data-bs-interval="10000">
              <img src="/img/hero_menu_img/Hero 1.png" class="d-block w-100" alt="First slide">
            </div>
            <div class="carousel-item" data-bs-interval="10000">
              <img src="/img/hero_menu_img/hero 2.png" class="d-block w-100" alt="Second slide">
            </div>
            <div class="carousel-item" data-bs-interval="10000">
              <img src="/img/hero_menu_img/hero 3.png" class="d-block w-100" alt="Third slide">
            </div>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>

      </section>

      <section class="FeaturedProduct">
        <div>
            <h2>Los mejores productos</h2>
            <div class="row">
                <% productosDestacados.forEach(producto => { %>
                    <div class="col-md-3 mb-4">
                        <div class="card">
                            <img src="<%= producto.imagen.data %>" class="card-img-top" alt="<%= producto.nombre %>" />
                            <div class="card-body">
                                <h5 class="card-title"><%= producto.nombre %></h5>
                                <p class="card-text">$<%= producto.precio.toFixed(2) %></p>
                                <a href="/tienda/producto/<%= producto._id %>" class="card-title text-white p-2" style="border-radius: 5px">Ver más</a>
                                <button class="btn btn-primary btn-agregar-carrito" data-producto-id="<%= producto._id %>">
                                    Agregar al Carrito
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>             

      <!-- Te puede interesar -->
<section>
  <h2>Te puede interesar</h2>
  <div class="MultiCarousel"
      data-items="1,3,5,6"
      data-slide="1"
      id="MultiCarousel"
      data-interval="1000">
      <div class="MultiCarousel-inner">
          <% productosParaCarousel.forEach(producto => { %>
              <div class="item">
                  <div class="card" style="width: 100%">
                      <img
                          class="card-img-top"
                          src="<%= producto.imagen.data %>"
                          alt="<%= producto.nombre %>"/>
                      <div class="card-body">
                          <h5 class="card-title"><%= producto.nombre %></h5>
                          <p class="card-text">$<%= producto.precio.toFixed(2) %></p>
                          <a href="/tienda/producto/<%= producto._id %>" class="card-title text-white p-2" style="border-radius: 5px">Ver más</a>
                          <button class="btn btn-primary btn-agregar-carrito" data-producto-id="<%= producto._id %>">Agregar al Carrito</button>
                      </div>
                  </div>
              </div>
          <% }); %>
      </div>
      <button class="btn leftLst bg-light text-dark"><</button>
      <button class="btn rightLst bg-light text-dark">></button>
  </div>
</section>        

<!-- Categorías recomendadas -->
<div class="categoria">
  <h2>Categorías Recomendadas</h2>
  <div class="categoria_items row row-cols-4">
      <% categoriasRecomendadas.forEach(categoria => { %>
          <div class="card" style="width: 15rem; background-color: #5e3b3b; color: #fff">
              <% if (categoria.productoDestacado && categoria.productoDestacado.imagen && categoria.productoDestacado.imagen.data) { %>
                  <img
                      class="card-img-top"
                      src="<%= categoria.productoDestacado.imagen.data %>"
                      alt="<%= categoria.productoDestacado.nombre %>"
                  />
              <% } else { %>
                  <img
                      class="card-img-top"
                      src="/ruta/a/imagen/por/defecto.jpg"
                      alt="Imagen no disponible"
                  />
              <% } %>
              <div class="card-body">
                  <h5 class="card-title">
                      <%= categoria.productoDestacado ? `${categoria.productoDestacado.nombre} - ${categoria.nombre}` : categoria.nombre %>
                  </h5>
                  <a href="/tienda/<%= categoria._id %>" class="btn btn-primary">Entrar al catálogo</a>
              </div>
          </div>
      <% }); %>
  </div>
</div>

      </section>

      <section class="sobre">
        <div class="card">
          <img
            class="card-img-bottom"
            src="/img/logo/LogoLetra.png"
            alt="Card image cap"
          />
        </div>

        <div class="card">
          <div class="card-body">
            <h1>Sobre ToolBox</h1>
            <p>
              Lorem ipsum dolor sit amet consectetur adipisicing elit. Eveniet
              pariatur modi, maiores veritatis corrupti vitae excepturi soluta
              dolorum totam, a, placeat accusantium non veniam sapiente ullam
              eius. Culpa, repellat quaerwasat!
            </p>
          </div>
        </div>
      </section>
    </div>
    
    <footer class="px-4 py-4">
      <div class="row">
        <div class="col-5 col-md-2 mb-3">
          <h5>Acerca de</h5>
          <ul class="list-unstyled mb-0">
            <li class="text-light">
              <a href="#!">Nosotros</a>
            </li>
            <li>
              <a href="#!">Servicios</a>
            </li>
            <li>
              <a href="#!">Productos</a>
            </li>
            <li>
              <a href="#!">Inventarios</a>
            </li>
          </ul>
        </div>
  
        <div class="col-5 col-md-2 mb-3">
          <h5>Pagos</h5>
          <ul class="list-unstyled mb-0">
            <li>
              <a href="#!">Metodos de Pago</a>
            </li>
            <li>
              <a href="#!">Cuenta</a>
            </li>
            <li>
              <a href="#!">Crear cuenta</a>
            </li>
          </ul>
        </div>
  
        <div class="col-5 col-md-2 mb-3">
          <h5>Contactos</h5>
          <ul class="list-unstyled">
            <li>
              <a href="https://www.whatsapp.com/?lang=es_LA"
