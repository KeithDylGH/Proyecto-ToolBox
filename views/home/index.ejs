<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ToolBox - Inicio</title>
    <link rel="icon" type="image/x-icon" href="/img/logo/Logo 180.png" />
    
    <!--BOOTSTRAP-->
   <!--  <link rel="stylesheet" href="/bootstrap-5.3.3-dist/css/bootstrap.rtl.min.css">
    <script src="/bootstrap-5.3.3-dist/js/bootstrap.bundle.js"></script> -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    

    <link rel="stylesheet" href="/css/home.css">
    <!-- <link rel="stylesheet" href="/css/header.css"> -->
    <link rel="stylesheet" href="/css/buscador.css">
    <link rel="stylesheet" href="/css/notificacion.css">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />

    <script src="/js/notificacion.js"></script>
    <!--Query para el Carrusel-->
    <script src="//code.jquery.com/jquery-1.11.1.min.js"></script>
  </head>
  <body>
    <header style="background-color: #5e3b3b; padding: 10px 0;">
        <nav class="navbar navbar-expand-lg" style="padding: 0 2rem;">
            <div class="container-fluid">
                <a class="navbar-brand" href="/" style="display: inline-block; margin-right: 15px;">
                    <img src="/img/logo/Logo Letra trazo.png" alt="Logo" class="w-25">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white active" aria-current="page" href="/">Inicio</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Categoría
                            </a>
                            <ul class="dropdown-menu">
                                <% if (categorias && categorias.length > 0) { %>
                                    <% categorias.forEach(categoria => { %>
                                        <li><a class="dropdown-item" href="/tienda/<%= categoria._id %>"><%= categoria.nombre %></a></li>
                                    <% }) %>
                                <% } else { %>
                                    <li><a class="dropdown-item" href="#">No hay categorías disponibles</a></li>
                                <% } %>
                            </ul>
                        </li>
                        <% if (CUsuario) { %>
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/cuenta"><%= CUsuario.nombre %></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/logout">Cerrar sesión</a>
                            </li>
                        <% } else { %>
                            <li class="nav-item">
                                <a class="nav-link text-white" id="login" href="/login">Iniciar sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" id="register" href="/registrar">Registrarse</a>
                            </li>
                        <% } %>
                        <li class="nav-item me-3"> <!-- Ajuste aquí -->
                            <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#carritoModal">
                                <img src="/img/icono/carrito de compras.png" alt="carrito" class="img-fluid" style="height: 30px;" />
                            </a>
    
                            <div class="modal fade" id="carritoModal" tabindex="-1" aria-labelledby="carritoModalLabel" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title text-black" id="carritoModalLabel">Tu Carrito de Compras</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <ul id="carritoList" class="list-group">
                                                <!-- Aquí se cargarán dinámicamente los productos del carrito -->
                                            </ul>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                            <a type="button" href="/cuenta/carrito" class="btn btn-primary">Más Detalles</a>
                                            <button type="button" id="vaciarCarrito" class="btn btn-warning">Vaciar Carrito</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                    </ul>
    
                    <form class="d-flex flex-column position-relative" id="productSearchForm">
                        <div class="d-flex">
                            <input class="form-control me-2" id="searchInput" type="search" placeholder="Busca aquí" aria-label="Search" autocomplete="off">
                        </div>
                        <div id="suggestions" class="list-group mt-2 position-absolute w-100"></div>
                    </form>
                </div>
            </div>
        </nav>
    </header>                             

  <!--NOTIFICACION-->
  <div class="notification d-none"></div>

    <div class="container">
      <section class="hero">
        
        <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
          <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
          </div>
          <div class="carousel-inner">
            <div class="carousel-item active" data-bs-interval="10000">
              <img src="/img/hero_menu_img/Hero 1.png" class="d-block w-100" alt="First slide">
            </div>
            <div class="carousel-item" data-bs-interval="10000">
              <img src="/img/hero_menu_img/hero 2.png" class="d-block w-100" alt="Second slide">
            </div>
            <div class="carousel-item" data-bs-interval="10000">
              <img src="/img/hero_menu_img/hero 3.png" class="d-block w-100" alt="Third slide">
            </div>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>

      </section>

      <section class="FeaturedProduct">
        <div>
            <h2>Los mejores productos</h2>
            <div class="row">
                <% productosDestacados.forEach(producto => { %>
                    <div class="col-md-3 mb-4">
                        <div class="card">
                            <img src="<%= producto.imagen.data %>" class="card-img-top" alt="<%= producto.nombre %>" />
                            <div class="card-body">
                                <h5 class="card-title"><%= producto.nombre %></h5>
                                <p class="card-text">$<%= producto.precio.toFixed(2) %></p>
                                <a href="/tienda/producto/<%= producto._id %>" class="card-title text-white p-2" style="border-radius: 5px; text-decoration: none;">Ver más</a>
                                <button class="btn btn-primary btn-agregar-carrito" data-producto-id="<%= producto._id %>">
                                    Agregar al Carrito
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>             

      <!-- Te puede interesar -->
<section>
  <h2>Te puede interesar</h2>
  <div class="MultiCarousel"
      data-items="1,3,5,6"
      data-slide="1"
      id="MultiCarousel"
      data-interval="1000">
      <div class="MultiCarousel-inner">
          <% productosParaCarousel.forEach(producto => { %>
              <div class="item">
                  <div class="card" style="width: 100%">
                      <img
                          class="card-img-top"
                          src="<%= producto.imagen.data %>"
                          alt="<%= producto.nombre %>"/>
                      <div class="card-body">
                          <h5 class="card-title"><%= producto.nombre %></h5>
                          <p class="card-text">$<%= producto.precio.toFixed(2) %></p>
                          <a href="/tienda/producto/<%= producto._id %>" class="card-title text-white p-2" style="border-radius: 5px; text-decoration: none;">Ver más</a>
                          <br>
                          <button class="btn btn-primary btn-agregar-carrito" data-producto-id="<%= producto._id %>">Agregar al Carrito</button>
                      </div>
                  </div>
              </div>
          <% }); %>
      </div>
      <button class="btn leftLst bg-light text-dark"><</button>
      <button class="btn rightLst bg-light text-dark">></button>
  </div>
</section>        

<!-- Categorías recomendadas -->
<div class="categoria">
  <h2>Categorías Recomendadas</h2>
  <div class="categoria_items row row-cols-4">
      <% categoriasRecomendadas.forEach(categoria => { %>
          <div class="card" style="width: 15rem; background-color: #5e3b3b; color: #fff">
              <% if (categoria.productoDestacado && categoria.productoDestacado.imagen && categoria.productoDestacado.imagen.data) { %>
                  <img
                      class="card-img-top"
                      src="<%= categoria.productoDestacado.imagen.data %>"
                      alt="<%= categoria.productoDestacado.nombre %>"
                  />
              <% } else { %>
                  <img
                      class="card-img-top"
                      src="/ruta/a/imagen/por/defecto.jpg"
                      alt="Imagen no disponible"
                  />
              <% } %>
              <div class="card-body">
                  <h5 class="card-title">
                      <%= categoria.productoDestacado ? `${categoria.productoDestacado.nombre} - ${categoria.nombre}` : categoria.nombre %>
                  </h5>
                  <a href="/tienda/<%= categoria._id %>" class="btn btn-primary">Entrar al catálogo</a>
              </div>
          </div>
      <% }); %>
  </div>
</div>

      </section>

      <section class="sobre">
        <div class="card mb-3" style="max-width: 540px; margin: auto;">
            <div class="row g-0">
                <div class="col-md-4">
                    <img
                        src="/img/logo/LogoLetra.png" 
                        class="img-fluid rounded-start" 
                        alt="Logo de ToolBox" 
                        style="max-width: 70%; height: auto; margin: 5px;"
                    >
                </div>
                <div class="col-md-8">
                    <div class="card-body" style="padding-bottom: 10px;">
                        <h5 class="card-title">Sobre ToolBox</h5>
                        <p class="card-text">
                            En <strong>ToolBox</strong>, nos enorgullecemos de ser tu aliado confiable en 
                            la compra de productos de ferretería y artículos esenciales para el hogar. 
                            Nuestra amplia gama de productos está diseñada para satisfacer todas tus necesidades, 
                            ya sea que estés llevando a cabo un proyecto grande o simplemente buscando mejorar tu espacio en casa.
                        </p>
                        <p class="card-text">
                            Nos comprometemos a proporcionar un entorno seguro para nuestras transacciones, garantizando la 
                            protección de tus datos personales y ofreciendo múltiples opciones de pago seguras. 
                        </p>
                        <a href="/acerca-de" style="color: rgb(187, 75, 10); text-decoration: none;">
                            <strong>Haz clic para ver más sobre nosotros</strong>
                        </a>
                    </div>
                </div>
            </div>
        </div>                            
    </section>
    
    </div>
    
    <footer>
        <div class="container text-center py-3">
          <div class="d-flex justify-content-center">
            <% if (CUsuario) { %>
              <a href="/cuenta" class="text-light me-3">Tu cuenta</a>
              <a href="/logout" class="text-light me-3">Cerrar sesión</a>
            <% } else { %>
              <a href="/login" class="text-light me-3">Iniciar sesión</a>
              <a href="/registrar" class="text-light me-3">Registrarse</a>
            <% } %>
            <a href="/acerca-de" class="text-light">Sobre nosotros</a>
          </div>
          <div class="social-media mt-2">
            <a href="https://www.facebook.com" class="text-light me-3" target="_blank">Facebook
              <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-brand-facebook" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.5" stroke="#ffffff" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3" />
              </svg>
            </a>
            <a href="https://www.X.com" class="text-light me-3" target="_blank">X 
              <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-brand-x" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.5" stroke="#ffffff" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
                <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
              </svg>
            </a>
            <a href="https://www.instagram.com" class="text-light" target="_blank">Instagram
              <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-brand-instagram" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.5" stroke="#ffffff" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M4 4m0 4a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z" />
                <path d="M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                <path d="M16.5 7.5l0 .01" />
              </svg>
            </a>
          </div>
          <p>© 2024 ToolBox. Todos los derechos reservados.</p>
        </div>
      </footer>

    <script src="/js/home.js"></script>
    <script src="/js/header.js"></script>
    <script src="/js/carrusel.js"></script>
    <script src="/js/buscador.js"></script>
    <script src="/js/logout.js"></script>
  </body>
</html>
